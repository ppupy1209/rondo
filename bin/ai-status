#!/usr/bin/env python3
"""zellij 상단 바 — 패널별 모델 · 컨텍스트 · 사용 한도.

각 CLI 가 로컬에 남기는 것만 읽는다. 자격증명으로 API 를 호출하지 않는다.

  claude  statusLine 이 남긴 캐시 (모델 · 컨텍스트% · 5시간/주간 한도)
  codex   ~/.codex/state_5.sqlite 의 threads (모델 · 누적 토큰)
  antigravity·gemini·kimi·grok  로컬에 사용량 상태를 남기지 않음 — "-" 로 표시

열려 있는 패널만 표시한다(zellij dump-layout 기준).

한 번만 출력하려면 --once.
"""
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import time

CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "ai-tools"
)
LIMITS = os.path.join(CACHE, "claude-limits.json")
CODEX_DB = os.path.expanduser("~/.codex/state_5.sqlite")
BAR_CELLS = 8
STALE_SECONDS = 3600
INTERVAL = 5


def repo_root():
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=5,
        )
        if out.returncode == 0:
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return os.getcwd()


def short_model(name):
    return (name or "-").replace("claude-", "").replace("-latest", "")


def tokens(n):
    if n is None:
        return None
    if n >= 1_000_000:
        return f"{n / 1_000_000:.1f}M"
    return f"{n / 1000:.0f}k" if n >= 1000 else str(n)


def battery(used_pct):
    """남은 비율을 배터리처럼. used 72 -> 28% 남음."""
    left = max(0.0, min(100.0, 100.0 - used_pct))
    filled = int(round(left / 100 * BAR_CELLS))
    return "\u2593" * filled + "\u2591" * (BAR_CELLS - filled), left


def claude_limits():
    """사용 한도는 계정 단위다. 어느 프로젝트에서 받았든 공유 파일에서 읽는다.
    리셋 시각이 지난 창은 버린다."""
    try:
        with open(LIMITS) as fh:
            limits = json.load(fh).get("rate_limits") or {}
    except (OSError, ValueError):
        return {}
    now = time.time()
    return {k: v for k, v in limits.items() if v.get("resets_at", 0) > now}


def until(epoch):
    secs = max(0, int(epoch - time.time()))
    mins, hours = secs // 60 % 60, secs // 3600
    if hours >= 24:
        return f"{hours // 24}d{hours % 24}h"
    return f"{hours}h{mins:02d}m" if hours else f"{mins}m"


def claude_field(root):
    limits = claude_limits()
    path = os.path.join(CACHE, "claude.%s.json" % os.path.basename(root))
    try:
        with open(path) as fh:
            d = json.load(fh)
    except (OSError, ValueError):
        d = {}
    # 다른 레포의 동명 프로젝트이거나 오래된 값이면 모델·컨텍스트는 쓰지 않는다
    if d.get("project") != root or time.time() - d.get("at", 0) > STALE_SECONDS:
        d = {}
    if not d and not limits:
        return None

    bits = [short_model(d.get("model"))] if d.get("model") else []
    if d.get("context_used") is not None:
        bits.append(f"ctx {d['context_used']:.0f}%")
    for key, label in (("five_hour", "5h"), ("seven_day", "wk")):
        window = limits.get(key)
        if window:
            bar, left = battery(window["used_percentage"])
            bits.append(f"{label} {bar} {left:.0f}%({until(window['resets_at'])})")
    return " ".join(bits)


def codex_field(root):
    if not os.path.exists(CODEX_DB):
        return None
    try:
        con = sqlite3.connect("file:%s?mode=ro" % CODEX_DB, uri=True, timeout=1)
        row = con.execute(
            # thread_source='user' 로 서브에이전트(auto-review 등) 스레드를 제외한다
            "SELECT model, reasoning_effort, tokens_used FROM threads "
            "WHERE cwd = ? AND thread_source = 'user' "
            "ORDER BY updated_at_ms DESC LIMIT 1",
            (root,),
        ).fetchone()
        con.close()
    except sqlite3.Error:
        return None
    if not row:
        return None
    model, effort, used = row
    bits = [short_model(model)]
    if effort:
        bits.append(effort)
    if tokens(used):
        # 현재 컨텍스트가 아니라 스레드 누적 토큰이다
        bits.append(tokens(used) + " tok")
    return " ".join(bits)


# 패널 이름 -> 값을 읽는 함수. 값이 없는 CLI 는 로컬에 상태를 안 남긴다.
AGENTS = [
    ("claude", claude_field),
    ("codex", codex_field),
    ("antigravity", None),
    ("gemini", None),
    ("kimi", None),
    ("grok", None),
]


def open_panes():
    """현재 세션에 열려 있는 패널 이름. zellij 밖이면 None."""
    if not os.environ.get("ZELLIJ_SESSION_NAME"):
        return None
    try:
        out = subprocess.run(
            ["zellij", "action", "dump-layout"],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return set(re.findall(r'name="([a-z-]+)"', out.stdout))


def line(root):
    panes = open_panes()
    parts = []
    for name, reader in AGENTS:
        if panes is not None and name not in panes:
            continue
        value = reader(root) if reader else None
        parts.append(f"{name} {value or '-'}")
    return "   ".join(parts) or "패널 없음"


def main():
    root = repo_root()
    once = "--once" in sys.argv
    while True:
        text = line(root)
        # 1행 패널이라 폭을 넘으면 줄바꿈돼 깨진다. 잘라낸다.
        width = shutil.get_terminal_size(fallback=(80, 24)).columns
        if len(text) > width:
            text = text[: max(0, width - 1)]
        # 커서를 좌상단으로 보내고 줄을 지운 뒤 다시 그린다
        sys.stdout.write("\033[H\033[2K" + text)
        sys.stdout.flush()
        if once:
            print()
            return
        time.sleep(INTERVAL)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
