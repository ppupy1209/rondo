#!/usr/bin/env python3
"""zellij 상단 바 — 패널별 모델과 남은 사용량.

렌더러다. 벤더 경로·스키마는 하나도 몰라야 한다 — lib/rondo/adapters 가 안다.
여기서 하는 일은 Snapshot 을 배터리 바와 문자열로 그리고, 열려 있는 패널만 고르고,
폭에 맞춰 자르는 것뿐이다.

한 번만 출력하려면 --once.
"""
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time

try:
    import termios
except ImportError:  # Windows ConPTY
    termios = None

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent.parent / "lib"))

from rondo.adapters import ClaudeAdapter, CodexAdapter, GeminiAdapter  # noqa: E402
from rondo.paths import CACHE, read_json, repo_key, setting  # noqa: E402

BAR_CELLS = 8
STALE_LIMITS = 120  # 이 초를 넘으면 한도 옆에 나이를 붙인다
INTERVAL = 5
SCHEDULE_INTERVAL = 30

# 읽기에 실패한 틱에서 값이 사라지지 않도록 마지막 성공값을 들고 있는다.
# DB 가 쓰기 중이면 열기가 실패해 바가 깜빡이던 문제를 막는다.
LAST = {}
SCHEDULE_PROCESS = None
LAST_SCHEDULE_TICK = 0.0


def repo_root():
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, timeout=5,
        )
        if out.returncode == 0:
            return out.stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    return os.getcwd()


def short_model(name):
    return (name or "-").replace("claude-", "").replace("-latest", "")


def battery(remaining):
    """남은 비율을 배터리처럼. 어댑터가 이미 remaining 으로 맞춰 준다."""
    filled = int(round(max(0.0, min(100.0, remaining)) / 100 * BAR_CELLS))
    return "▓" * filled + "░" * (BAR_CELLS - filled)


def until(epoch):
    secs = max(0, int(epoch - time.time()))
    mins, hours = secs // 60 % 60, secs // 3600
    if hours >= 24:
        return f"{hours // 24}d{hours % 24}h"
    return f"{hours}h{mins:02d}m" if hours else f"{mins}m"


def render(snapshot, compact=0):
    """Snapshot -> 한 패널 몫의 문자열. 모든 벤더가 이 함수 하나를 지난다."""
    windows = snapshot.live_windows()
    if compact >= 2:
        return "/".join(f"{window.remaining:.0f}" for window in windows) + "%" if windows else "-"
    model = short_model(snapshot.model)
    if compact == 1 and model:
        model = model.split()[0]
    bits = [model] if model else []
    for window in windows:
        bits.append(f"{window.label} {window.remaining:.0f}%" if compact else (
            f"{window.label} {battery(window.remaining)} "
            f"{window.remaining:.0f}%({until(window.resets_at)})"
        ))
    # 실제 잔량과 어긋나 보일 수 있으니 값이 낡았으면 언제 기준인지 밝힌다
    if not compact and windows and snapshot.age > STALE_LIMITS:
        bits.append("%dm전" % (snapshot.age // 60))
    return " ".join(bits) or None


AGENTS = [
    ("claude", ClaudeAdapter()),
    ("codex", CodexAdapter()),
    ("gemini", GeminiAdapter()),
    ("kimi", None),
    ("grok", None),
]


def relay_field(root):
    data = read_json(CACHE / "relay" / repo_key(root) / "pending.json")
    if not data:
        return None
    status = data.get("status")
    if status in ("completed", "failed") and time.time() - data.get("updated_at", 0) > 300:
        return None
    language = setting("language", "en")
    labels = {
        "ready": "인계 준비" if language == "ko" else "ready",
        "running": "인계 중" if language == "ko" else "running",
        "completed": "인계 완료" if language == "ko" else "complete",
        "failed": "인계 실패" if language == "ko" else "failed",
    }
    return labels.get(status)


def open_panes():
    """현재 세션에 열려 있는 패널 이름. zellij 밖이면 None."""
    if not os.environ.get("ZELLIJ_SESSION_NAME"):
        return None
    try:
        out = subprocess.run(
            ["zellij", "action", "dump-layout"],
            capture_output=True, text=True, timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if out.returncode != 0:
        return None
    return set(re.findall(r'name="([a-z-]+)"', out.stdout))


def tick_schedules(root):
    """Let approved jobs advance while this visible Rondo session is alive."""
    global LAST_SCHEDULE_TICK, SCHEDULE_PROCESS
    if not os.environ.get("ZELLIJ_SESSION_NAME"):
        return
    if SCHEDULE_PROCESS is not None and SCHEDULE_PROCESS.poll() is None:
        return
    now = time.monotonic()
    if now - LAST_SCHEDULE_TICK < SCHEDULE_INTERVAL:
        return
    binary = shutil.which("rondo")
    if not binary:
        return
    command = [binary, "schedule", "tick", "--quiet"]
    if os.name == "nt" and pathlib.Path(binary).suffix.lower() in (".cmd", ".bat"):
        command = [os.environ.get("COMSPEC", "cmd.exe"), "/d", "/c", *command]
    environment = os.environ.copy()
    environment.pop("RONDO_AGENT", None)
    try:
        SCHEDULE_PROCESS = subprocess.Popen(
            command, cwd=root, env=environment,
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
        )
        LAST_SCHEDULE_TICK = now
    except OSError:
        pass


def line(root, width=None):
    panes = open_panes()
    snapshots = []
    for name, adapter in AGENTS:
        if panes is not None and name not in panes:
            continue
        snapshot = adapter.snapshot(root) if adapter else None
        value = render(snapshot) if snapshot else None
        if value:
            LAST[name] = snapshot
        else:
            snapshot = LAST.get(name)
        snapshots.append((name, snapshot))
    relay = relay_field(root)
    empty = "패널 없음" if setting("language", "en") == "ko" else "no panes"
    short_names = {"claude": "cl", "codex": "cx", "gemini": "gm", "kimi": "km", "grok": "gr"}
    for compact in (0, 1, 2):
        parts = [
            f"{short_names[name] if compact >= 2 else name} "
            f"{render(snapshot, compact) if snapshot else '-'}"
            for name, snapshot in snapshots
        ]
        if relay:
            parts.append(f"relay→cx {relay}" if compact >= 2 else f"relay→codex {relay}")
        text = (" " if compact >= 2 else "   ").join(parts) or empty
        if width is None or len(text) < width:
            return text
    return text[: max(0, (width or 1) - 1)].rstrip()


def mute_input(fd):
    """상태 바는 읽을 게 없다. 클릭해서 타이핑해도 화면이 밀리지 않도록 에코를 끈다."""
    if termios is None:
        return
    try:
        attrs = termios.tcgetattr(fd)
        attrs[3] &= ~(termios.ECHO | termios.ICANON)
        termios.tcsetattr(fd, termios.TCSANOW, attrs)
    except (OSError, ValueError):
        pass


def main():
    root = repo_root()
    once = "--once" in sys.argv
    fd = sys.stdin.fileno() if sys.stdin.isatty() else None
    if fd is not None:
        mute_input(fd)

    while True:
        if not once:
            tick_schedules(root)
        width = shutil.get_terminal_size(fallback=(80, 24)).columns
        text = line(root, width)
        # 커서를 좌상단으로 보내고 줄을 지운 뒤 다시 그린다
        sys.stdout.write("\033[H\033[2K" + text)
        sys.stdout.flush()
        if once:
            print()
            return
        if fd is not None and termios is not None:
            # 클릭 후 눌린 키가 버퍼에 쌓이지 않도록 버린다
            try:
                termios.tcflush(fd, termios.TCIFLUSH)
            except OSError:
                pass
        time.sleep(INTERVAL)


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
