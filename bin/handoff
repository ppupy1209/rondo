#!/bin/sh
# 작업 중인 레포의 핸드오프 파일을 갱신한다.
#   - 지난 실행 이후 쌓인 커밋을 '## 현재 단계' 맨 위에 추가
#   - 항목이 KEEP 개를 넘으면 오래된 것부터 archive 로 이동
#
#   handoff [에이전트이름]   갱신 (기본 Claude)
#   handoff --init          이 레포에 docs/handoff.md 생성
#
# 대상 파일이 없으면 아무것도 하지 않는다. 레포마다 파일을 만들어 두는 것이 opt-in.
set -eu

KEEP=20
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/rondo"
LANGUAGE=$(cat "$CONFIG_DIR/language" 2>/dev/null || printf en)
if [ "$LANGUAGE" = ko ]; then
    SECTION='## 현재 단계'
    UPDATE='> 업데이트:'
    INIT='# 핸드오프\n\n> 업데이트: -\n\n## 현재 단계\n\n## 다음 액션\n\n- \n'
    ARCHIVE_TITLE='# 현재 단계 아카이브\n\n> 본문에서 밀려난 항목. 최신이 위.\n'
else
    SECTION='## Current stage'
    UPDATE='> Updated:'
    INIT='# Handoff\n\n> Updated: -\n\n## Current stage\n\n## Next actions\n\n- \n'
    ARCHIVE_TITLE='# Current stage archive\n\n> Entries moved out of the active document. Newest first.\n'
fi

# 작업 레포 찾기 — 훅은 임의의 cwd 에서 실행될 수 있다
root="${CLAUDE_PROJECT_DIR:-}"
[ -n "$root" ] || root=$(git rev-parse --show-toplevel 2>/dev/null || true)
[ -n "$root" ] || { echo "handoff: not a Git repository" >&2; exit 0; }
cd "$root"

if [ "${1:-}" = "--init" ]; then
    [ -f docs/handoff.md ] && { echo "handoff: docs/handoff.md already exists"; exit 0; }
    mkdir -p docs
    printf '%b' "$INIT" > docs/handoff.md
    echo "handoff: created docs/handoff.md"
    exit 0
fi

AGENT="${1:-${HANDOFF_AGENT:-Claude}}"

# 대상 파일: 환경변수 > 레포 규약 파일 > 기본 파일. 없으면 조용히 종료
STATUS="${HANDOFF_FILE:-}"
if [ -z "$STATUS" ]; then
    for f in docs/collab/status.md docs/handoff.md; do
        [ -f "$f" ] && { STATUS="$f"; break; }
    done
fi
[ -n "$STATUS" ] || exit 0
if grep -q '^## 현재 단계$' "$STATUS"; then
    SECTION='## 현재 단계'
    UPDATE='> 업데이트:'
elif grep -q '^## Current stage$' "$STATUS"; then
    SECTION='## Current stage'
    UPDATE='> Updated:'
else
    echo "handoff: $STATUS has no current-stage section" >&2
    exit 0
fi

ARCHIVE="$(dirname "$STATUS")/archive/$(basename "$STATUS" .md)-log.md"
MARK=.git/handoff-head   # 세션 간 기준 커밋. .git 안이라 커밋되지 않는다

head_now=$(git rev-parse HEAD 2>/dev/null) || exit 0
last=$(cat "$MARK" 2>/dev/null || true)

# 첫 실행이거나 기준 커밋이 사라진 경우(rebase 등)에는 기준점만 남긴다
if [ -z "$last" ] || ! git cat-file -e "$last^{commit}" 2>/dev/null; then
    echo "$head_now" > "$MARK"
    echo "handoff: 기준 커밋 기록 ($(git rev-parse --short HEAD))"
    exit 0
fi

new=$(git log --format="- $(date +%F) · $AGENT — %s" "$last..$head_now")

mkdir -p "$(dirname "$ARCHIVE")"
tmp=$(mktemp)
overflow=$(mktemp)

# 1) 새 항목 삽입 + 업데이트 줄 갱신 (여러 줄이라 -v 대신 환경변수로 넘긴다)
NEW="$new" awk -v agent="$AGENT" -v today="$(date +%F)" -v section="$SECTION" -v update="$UPDATE" '
    BEGIN { new = ENVIRON["NEW"]; if (new == "") added = 1 }
    index($0, update) == 1 && new != "" { print update " " today " · " agent; next }
    /^## / {
        if (insec && !added) { print new; added = 1 }
        insec = ($0 == section)
        print; next
    }
    insec && !added && /^- / { print new; added = 1 }
    { print }
    END { if (insec && !added) print new }
' "$STATUS" |
# 2) KEEP 개 초과분을 overflow 로 분리 (빠진 자리에 남는 빈 줄도 접는다)
awk -v keep="$KEEP" -v ovf="$overflow" -v section="$SECTION" '
    /^## / { if (!blank && NR > 1) print ""; insec = ($0 == section); drop = 0 }
    insec && /^- / { drop = (++n > keep); if (drop) { print > ovf; next } }
    insec && drop && /^[ \t]+/ { print > ovf; next }   # 항목에 딸린 하위 줄
    insec && drop && /^[ \t]*$/ { next }               # 항목에 딸린 빈 줄
    insec && /^[ \t]*$/ { if (blank) next; blank = 1; print; next }
    { blank = ($0 ~ /^[ \t]*$/); drop = 0; print }
' > "$tmp"

# 안전장치: awk 가 실패해 결과가 비거나 섹션이 사라지면 원본을 건드리지 않는다
if [ ! -s "$tmp" ] || ! grep -Fqx "$SECTION" "$tmp"; then
    rm -f "$tmp" "$overflow"
    echo "handoff: 생성 결과 이상 — $STATUS 유지" >&2
    exit 1
fi

moved=$(wc -l < "$overflow" | tr -d ' ')
if [ -s "$overflow" ]; then
    [ -f "$ARCHIVE" ] || printf '%b' "$ARCHIVE_TITLE" > "$ARCHIVE"
    { printf '\n## %s 정리\n\n' "$(date +%F)"; cat "$overflow"; } >> "$ARCHIVE"
fi

mv "$tmp" "$STATUS"
echo "$head_now" > "$MARK"
rm -f "$overflow"

added=$(printf '%s' "$new" | grep -c '^- ' || true)
echo "handoff: $STATUS · 추가 ${added}건 · 아카이브 ${moved}건"
