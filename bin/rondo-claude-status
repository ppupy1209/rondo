#!/usr/bin/env python3
"""Claude status line and Rondo continuity trigger."""

from __future__ import annotations

import json
import os
import subprocess
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rondo.adapters import claude  # noqa: E402
from rondo.paths import CACHE, atomic_json, read_json, repo_key, setting  # noqa: E402

BAR_CELLS = 8
WINDOWS = os.name == "nt"
if WINDOWS:
    sys.stdout.reconfigure(encoding="utf-8")


def battery(left: float) -> str:
    filled = int(round(left / 100 * BAR_CELLS))
    return "▓" * filled + "░" * (BAR_CELLS - filled)


def remaining(epoch: float) -> str:
    seconds = max(0, int(epoch - time.time()))
    minutes, hours = seconds // 60 % 60, seconds // 3600
    if hours >= 24:
        return f"{hours // 24}d{hours % 24}h"
    return f"{hours}h{minutes:02d}m" if hours else f"{minutes}m"


def trigger_limit(data: dict):
    """가장 빠듯한 창. 스키마는 어댑터가 안다."""
    return claude.tightest(claude.windows_from_payload(data))


def maybe_relay(data: dict) -> None:
    mode = setting("relay", "ready")
    if mode == "off":
        return
    limit = trigger_limit(data)
    try:
        threshold = float(setting("threshold", "1"))
    except ValueError:
        threshold = 1.0
    if not limit or limit.remaining > threshold:
        return
    project = claude.project_dir(data)
    session = str(data.get("session_id") or "unknown")
    if not project:
        return

    relay_root = CACHE / "relay" / repo_key(project)
    marker = relay_root / "triggers" / f"{session}-{int(limit.resets_at)}"
    marker.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        descriptor = os.open(marker, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
        os.close(descriptor)
    except FileExistsError:
        return

    source = relay_root / "inbox" / f"{session}-{time.time_ns()}.json"
    try:
        atomic_json(source, data)
        relay = Path(__file__).resolve().with_name("rondo-relay")
        command = [sys.executable, str(relay), "--capture", str(source)] if WINDOWS else [str(relay), "--capture", str(source)]
        detached = {"creationflags": subprocess.CREATE_NEW_PROCESS_GROUP} if WINDOWS else {"start_new_session": True}
        with open(os.devnull, "w") as quiet:
            subprocess.Popen(
                command,
                stdin=subprocess.DEVNULL,
                stdout=quiet,
                stderr=quiet,
                close_fds=True,
                **detached,
            )
    except OSError:
        marker.unlink(missing_ok=True)


def relay_badge(project: str | None) -> str | None:
    if not project:
        return None
    index = read_json(CACHE / "relay" / repo_key(project) / "pending.json")
    if not index:
        return None
    if index.get("status") in ("sent", "completed", "failed") and time.time() - index.get("updated_at", 0) > 300:
        return None
    language = setting("language", "en")
    labels = {
        "ready": "Codex 인계 준비" if language == "ko" else "Codex relay ready",
        "running": "Codex 인계 중" if language == "ko" else "Codex relay running",
        "sent": "Codex에 요청 전달" if language == "ko" else "Sent to Codex pane",
        "completed": "Codex 인계 완료" if language == "ko" else "Codex relay complete",
        "failed": "Codex 인계 실패" if language == "ko" else "Codex relay failed",
    }
    return labels.get(index.get("status"))


def main() -> None:
    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return

    parts = [claude.model_from_payload(data) or "?"]
    for window in claude.windows_from_payload(data):
        parts.append(
            f"{window.label} {battery(window.remaining)} "
            f"{window.remaining:.0f}% ({remaining(window.resets_at)})"
        )
    badge = relay_badge(claude.project_dir(data))
    if badge:
        parts.append(badge)
    print(" · ".join(parts))
    claude.write_cache(data)
    maybe_relay(data)


if __name__ == "__main__":
    main()
