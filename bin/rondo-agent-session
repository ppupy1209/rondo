#!/usr/bin/env python3
"""Run one native AI CLI and watch only for explicit quota exhaustion."""

from __future__ import annotations

import os
import subprocess
import sys
import time
import uuid
from pathlib import Path
from typing import List

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rondo import core


def executable(command: List[str]) -> List[str]:
    if os.name == "nt" and Path(command[0]).suffix.lower() in (".cmd", ".bat"):
        return [os.environ.get("COMSPEC", "cmd.exe"), "/d", "/s", "/c", *command]
    return command


def last_checkpoint(root: Path) -> str:
    state = core.load_state(root)
    checkpoints = state.get("checkpoints", [])
    if checkpoints:
        return checkpoints[-1].get("summary", "사용량 제한으로 중단된 작업을 이어서 진행하세요")
    return "사용량 제한으로 중단된 작업을 .rondo/context.md에서 확인하고 이어서 진행하세요"


def quota_handoff(root: Path, agent: str, session: str) -> None:
    config = core.load_config(root)
    if config["failover"] == "off":
        core.append_message(root, core.display_name(agent), "User", "사용량 제한으로 작업이 중단되었습니다.", "quota", session)
        return
    if config["failover"] == "ask":
        core.append_message(root, core.display_name(agent), "User", "사용량 제한입니다. `rondo next`로 이어갈 AI를 선택하세요.", "quota", session)
        return
    try:
        core.handoff(root, agent, session, last_checkpoint(root), reason="quota")
    except core.RondoError as error:
        core.append_message(root, "Rondo", "User", "자동 인계 대기: %s" % error, "quota", session)


def run(agent: str, extra: List[str], reviewer: bool = False) -> int:
    agent = core.normalize_agent(agent)
    root = core.find_project_root(Path(os.environ.get("RONDO_PROJECT_ROOT", Path.cwd())))
    core.init_project(root)
    session = uuid.uuid4().hex
    pane_id = os.environ.get("ZELLIJ_PANE_ID", "")
    role = "reviewer" if reviewer else "worker"
    os.environ.update(
        {
            "RONDO_AGENT": agent,
            "RONDO_SESSION_ID": session,
            "RONDO_PROJECT_ROOT": str(root),
            "RONDO_ZELLIJ_SESSION": os.environ.get("ZELLIJ_SESSION_NAME", os.environ.get("RONDO_ZELLIJ_SESSION", "")),
        }
    )
    core.register_session(root, agent, session, pane_id, role)
    command = executable([*core.provider_command(agent, root, role), *extra])
    process = None
    handed_off = False
    try:
        process = subprocess.Popen(command, cwd=str(root), env=os.environ.copy())
        process.wait()
        # Some CLIs exit immediately after rendering a quota message. The
        # wrapper pane still contains that final screen, so sample it twice
        # before closing instead of treating an ambiguous exit code as quota.
        consecutive = 0
        for _sample in range(2):
            if handed_off:
                break
            screen = core.dump_pane(os.environ.get("RONDO_ZELLIJ_SESSION", ""), pane_id)
            consecutive = consecutive + 1 if core.quota_exhausted(screen) else 0
            if consecutive >= 2:
                quota_handoff(root, agent, session)
                handed_off = True
                break
            time.sleep(0.25)
        return int(process.returncode or 0)
    finally:
        core.close_session(root, session, "quota_exhausted" if handed_off else "closed")


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: rondo-agent-session claude|codex|gemini [--reviewer] [provider arguments]", file=sys.stderr)
        return 2
    agent = sys.argv[1]
    rest = sys.argv[2:]
    reviewer = "--reviewer" in rest
    rest = [item for item in rest if item != "--reviewer"]
    return run(agent, rest, reviewer)


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except core.RondoError as error:
        print("rondo: %s" % error, file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        raise SystemExit(130)
