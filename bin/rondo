#!/usr/bin/env python3
"""Rondo: visible continuity between native Claude, Codex and Gemini CLIs."""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import List, Optional

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rondo import __version__
from rondo import core


HELP = """Rondo {version} - AI CLI 사이의 가벼운 인계 도구

사용법:
  rondo                         현재 프로젝트의 AI 패널과 Relay 열기
  rondo setup                   사용할 AI와 승인 모드 설정
  rondo context on|off          구조화된 작업 맥락 공유 켜기/끄기
  rondo task "목표"             현재 작업 목표 기록
  rondo checkpoint "요약"       다음 AI가 이어갈 핵심 상태 기록
  rondo next [AI] ["요약"]      다른 AI에게 작업 인계
  rondo message <AI> "메시지"   대상 AI 화면에 직접 입력하고 Relay에 기록
  rondo request-review [AI]     구현과 분리된 최종 검증 요청
  rondo review pass|fail "요약" 독립 검증 결과 기록
  rondo status                  현재 작업·인계·검증 상태 표시

지원 AI: claude, codex, gemini
각 AI의 공식 CLI는 별도로 설치되어 PATH에 있어야 합니다.
""".format(version=__version__)


def kdl(value: str) -> str:
    return json.dumps(str(value), ensure_ascii=False)


def write_layout(root: Path, agents: List[str]) -> Path:
    target = core.ensure_safe_state_dir(root) / "layout.kdl"
    runtime = Path(__file__).resolve().parent
    python = kdl(sys.executable)
    agent_session = kdl(str(runtime / "rondo-agent-session"))
    relay = kdl(str(runtime / "rondo-relay"))
    lines = [
        "layout {",
        "    tab name=\"Agents\" focus=true {",
        "        pane size=1 borderless=true {",
        "            plugin location=\"tab-bar\"",
        "        }",
    ]

    def append_agent(agent: str, index: int, indent: int) -> None:
        prefix = " " * indent
        focus = " focus=true" if index == 0 else ""
        lines.extend(
            [
                "%spane name=%s command=%s cwd=%s%s {" % (
                    prefix,
                    kdl(core.display_name(agent)), python, kdl(str(root)), focus
                ),
                "%s    args %s %s" % (prefix, agent_session, kdl(agent)),
                "%s}" % prefix,
            ]
        )

    if len(agents) == 3:
        lines.append("        pane split_direction=\"vertical\" {")
        append_agent(agents[0], 0, 12)
        lines.append("            pane split_direction=\"horizontal\" {")
        for index, agent in enumerate(agents[1:], start=1):
            append_agent(agent, index, 16)
        lines.extend(["            }", "        }"])
    else:
        lines.append("        pane split_direction=\"vertical\" {")
        for index, agent in enumerate(agents):
            append_agent(agent, index, 12)
        lines.append("        }")

    lines.extend(
        [
            "        pane size=1 borderless=true {",
            "            plugin location=\"status-bar\"",
            "        }",
            "    }",
            "    tab name=\"Relay\" {",
            "        pane size=1 borderless=true {",
            "            plugin location=\"tab-bar\"",
            "        }",
            "        pane name=\"Relay\" command=%s cwd=%s {" % (python, kdl(str(root))),
            "            args %s" % relay,
            "        }",
            "        pane size=1 borderless=true {",
            "            plugin location=\"status-bar\"",
            "        }",
            "    }",
            "}",
        ]
    )
    core._atomic_write(target, "\n".join(lines) + "\n")
    return target


def installed_agents() -> List[str]:
    return [agent for agent in core.AGENTS if core.provider_executable(agent)]


def _read_key() -> str:
    if os.name == "nt":
        import msvcrt

        key = msvcrt.getwch()
        if key in ("\x00", "\xe0"):
            return {"H": "up", "P": "down"}.get(msvcrt.getwch(), "")
        if key == "\x03":
            raise KeyboardInterrupt
        return {" ": "toggle", "\r": "confirm", "\x1b": "cancel"}.get(key, "")

    import select
    import termios
    import tty

    descriptor = sys.stdin.fileno()
    previous = termios.tcgetattr(descriptor)
    try:
        tty.setraw(descriptor)
        key = os.read(descriptor, 1)
        if key == b"\x03":
            raise KeyboardInterrupt
        if key == b"\x1b":
            sequence = key
            while len(sequence) < 3 and select.select([descriptor], [], [], 0.05)[0]:
                sequence += os.read(descriptor, 3 - len(sequence))
            return {b"\x1b[A": "up", b"\x1b[B": "down", b"\x1b": "cancel"}.get(sequence, "")
        return {b" ": "toggle", b"\r": "confirm", b"\n": "confirm"}.get(key, "")
    finally:
        termios.tcsetattr(descriptor, termios.TCSADRAIN, previous)


def choose_agents(available: List[str], defaults: List[str]) -> List[str]:
    if not available:
        raise core.RondoError("설치된 공식 AI CLI가 없습니다. Codex, Claude, Gemini 중 하나를 먼저 설치하세요.")
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise core.RondoError("AI 선택에는 대화형 터미널이 필요합니다. 자동화에서는 `rondo setup --agents claude,codex`를 사용하세요.")

    enabled = {agent for agent in defaults if agent in available} or set(available)
    cursor = next(index for index, agent in enumerate(core.AGENTS) if agent in available)
    status = "Space 선택/해제 · Enter 완료 · Esc 취소"
    line_count = len(core.AGENTS) + 2
    rendered = False
    while True:
        if rendered:
            sys.stdout.write("\x1b[%dA" % line_count)
        lines = ["사용할 AI 선택 (↑/↓ 이동)"]
        for index, agent in enumerate(core.AGENTS):
            marker = ">" if index == cursor else " "
            if agent not in available:
                lines.append("%s [-] %s (설치되지 않음)" % (marker, core.display_name(agent)))
            else:
                lines.append("%s [%s] %s" % (marker, "x" if agent in enabled else " ", core.display_name(agent)))
        lines.append(status)
        sys.stdout.write("".join("\r\x1b[2K%s\n" % line for line in lines))
        sys.stdout.flush()
        rendered = True

        key = _read_key()
        selectable = [index for index, agent in enumerate(core.AGENTS) if agent in available]
        position = selectable.index(cursor)
        if key == "up":
            cursor = selectable[(position - 1) % len(selectable)]
        elif key == "down":
            cursor = selectable[(position + 1) % len(selectable)]
        elif key == "toggle":
            agent = core.AGENTS[cursor]
            enabled.symmetric_difference_update({agent})
        elif key == "confirm":
            if enabled:
                return [agent for agent in core.AGENTS if agent in enabled]
            status = "최소 한 개의 AI를 선택하세요."
        elif key == "cancel":
            raise KeyboardInterrupt


def choose_approval(default: str) -> str:
    if not sys.stdin.isatty() or not sys.stdout.isatty():
        raise core.RondoError("승인 모드 선택에는 대화형 터미널이 필요합니다. 자동화에서는 `rondo setup --approval manual`을 사용하세요.")
    options = (
        ("manual", "일일이 승인", "수정과 명령을 직접 확인"),
        ("workspace", "프로젝트 안에서 자동 승인", "프로젝트 밖과 위험 작업은 계속 보호"),
    )
    cursor = next((index for index, item in enumerate(options) if item[0] == default), 0)
    rendered = False
    while True:
        if rendered:
            sys.stdout.write("\x1b[4A")
        lines = ["승인 모드 선택 (↑/↓ 이동)"]
        for index, (_value, label, detail) in enumerate(options):
            lines.append("%s (%s) %s - %s" % (">" if index == cursor else " ", "x" if index == cursor else " ", label, detail))
        lines.append("Enter 완료 · Esc 취소")
        sys.stdout.write("".join("\r\x1b[2K%s\n" % line for line in lines))
        sys.stdout.flush()
        key = _read_key()
        if key == "up":
            cursor = (cursor - 1) % len(options)
        elif key == "down":
            cursor = (cursor + 1) % len(options)
        elif key == "confirm":
            return options[cursor][0]
        elif key == "cancel":
            raise KeyboardInterrupt


def setup(
    root: Path,
    requested: Optional[str] = None,
    context: Optional[bool] = None,
    approval: Optional[str] = None,
) -> dict:
    available = installed_agents()
    config_path = core.state_dir(root) / "config.json"
    previous = core.load_config(root) if config_path.exists() else dict(core.DEFAULT_CONFIG)
    if requested is None:
        agents = choose_agents(available, previous["agents"])
    else:
        if not requested.strip():
            raise core.RondoError("최소 한 개의 AI를 선택하세요.")
        agents = []
        for item in requested.split(","):
            agent = core.normalize_agent(item)
            if agent not in agents:
                agents.append(agent)
    if not agents:
        raise core.RondoError("최소 한 개의 AI를 선택하세요.")
    missing = [core.display_name(agent) for agent in agents if not core.provider_executable(agent)]
    if missing:
        raise core.RondoError("공식 CLI가 PATH에 없습니다: %s" % ", ".join(missing))
    previous["agents"] = agents
    if approval is None and requested is None:
        approval = choose_approval(previous.get("approval", "manual"))
    if approval is not None:
        if approval not in ("manual", "workspace"):
            raise core.RondoError("승인 모드는 manual 또는 workspace 중 하나여야 합니다.")
        previous["approval"] = approval
    if context is not None:
        previous["context"] = context
    config, _state = core.init_project(root, previous)
    approval_label = "일일이 승인" if config["approval"] == "manual" else "프로젝트 안에서 자동 승인"
    print("설정 완료: %s / 승인: %s / 맥락 공유 %s" % (
        ", ".join(core.display_name(a) for a in agents), approval_label,
        "켜짐" if config["context"] else "꺼짐",
    ))
    return config


def open_session(root: Path) -> int:
    zellij = core.zellij_executable()
    if not zellij:
        raise core.RondoError("Zellij이 설치되어 있지 않습니다. Rondo 설치 스크립트를 다시 실행하세요.")
    config_path = core.state_dir(root) / "config.json"
    if not config_path.exists():
        setup(root)
    config, _state = core.init_project(root)
    missing = [agent for agent in config["agents"] if not core.provider_executable(agent)]
    if missing:
        raise core.RondoError("다음 공식 CLI를 찾을 수 없습니다: %s. `rondo setup`으로 다시 선택하세요." % ", ".join(missing))
    name = core.session_name(root)
    os.environ["RONDO_PROJECT_ROOT"] = str(root)
    os.environ["RONDO_ZELLIJ_SESSION"] = name
    session_status = core.zellij_session_status(name)
    if session_status == "active":
        return subprocess.call([
            zellij, "attach", name, "options", "--mouse-mode", "true",
            "--default-mode", "normal", "--simplified-ui", "true",
        ])
    if session_status == "exited" and not core.delete_exited_zellij_session(name):
        raise core.RondoError("종료된 이전 Rondo 화면을 정리하지 못했습니다. 잠시 후 다시 실행하세요.")
    core.cleanup_stale_windows_marker(name)
    core.retire_active_sessions(root)
    layout = write_layout(root, config["agents"])
    return subprocess.call(
        [
            zellij, "-s", name, "-n", str(layout), "options", "--mouse-mode", "true",
            "--default-mode", "normal", "--simplified-ui", "true",
        ],
        cwd=str(root),
    )


def current_identity() -> tuple:
    return core.session_identity()


def spawn_reviewer(root: Path, agent: str) -> bool:
    name = os.environ.get("ZELLIJ_SESSION_NAME") or core.session_name(root)
    command = str(Path(__file__).resolve().parent / "rondo-agent-session")
    args = [
        core.zellij_executable(), "-s", name, "action", "new-tab", "-n", "Review %s" % core.display_name(agent),
        "-c", str(root), "--", sys.executable, command, agent, "--reviewer",
    ]
    try:
        result = subprocess.run(args, capture_output=True, text=True, timeout=10, check=False)
        return result.returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def latest_summary(root: Path) -> str:
    state = core.load_state(root)
    checkpoints = state.get("checkpoints", [])
    return checkpoints[-1].get("summary", "현재 작업을 이어서 진행하세요") if checkpoints else "현재 작업을 이어서 진행하세요"


def show_status(root: Path) -> None:
    config = core.load_config(root)
    state = core.load_state(root)
    task = state["task"]
    review = state["review"]
    print("AI: %s" % ", ".join(core.display_name(a) for a in config["agents"]))
    print("맥락 공유: %s" % ("켜짐" if config["context"] else "꺼짐"))
    print("승인 모드: %s" % ("일일이 승인" if config["approval"] == "manual" else "프로젝트 안에서 자동 승인"))
    print("작업: %s" % (task.get("goal") or "기록되지 않음"))
    print("현재 담당: %s" % (task.get("owner") or "없음"))
    print("상태: %s / 독립 검증: %s" % (task.get("status", "idle"), review.get("status", "not_requested")))


def parser() -> argparse.ArgumentParser:
    value = argparse.ArgumentParser(add_help=False)
    value.add_argument("--help", "-h", action="store_true")
    value.add_argument("--version", "-V", action="store_true")
    value.add_argument("command", nargs="?")
    value.add_argument("rest", nargs=argparse.REMAINDER)
    return value


def main(argv: Optional[List[str]] = None) -> int:
    args = parser().parse_args(argv)
    if args.help:
        print(HELP)
        return 0
    if args.version:
        print("rondo %s" % __version__)
        return 0
    root = core.find_project_root()
    command = args.command
    rest = args.rest
    if not command:
        return open_session(root)
    if command == "help":
        print(HELP)
    elif command == "setup":
        requested = None
        context = None
        approval = None
        if "--agents" in rest:
            index = rest.index("--agents")
            if index + 1 >= len(rest):
                raise core.RondoError("--agents 뒤에 AI 목록이 필요합니다.")
            requested = rest[index + 1]
        if "--context-on" in rest:
            context = True
        if "--context-off" in rest:
            context = False
        if "--approval" in rest:
            index = rest.index("--approval")
            if index + 1 >= len(rest):
                raise core.RondoError("--approval 뒤에 manual 또는 workspace가 필요합니다.")
            approval = rest[index + 1]
        setup(root, requested, context, approval)
    elif command == "context":
        if len(rest) != 1 or rest[0] not in ("on", "off"):
            raise core.RondoError("사용법: rondo context on|off")
        config = core.load_config(root)
        config["context"] = rest[0] == "on"
        core.save_config(root, config)
        core.render_context(root, config=config)
        print("맥락 공유를 %s." % ("켰습니다" if config["context"] else "껐습니다"))
    elif command == "task":
        if not rest:
            raise core.RondoError("사용법: rondo task \"작업 목표\"")
        agent, session = current_identity()
        core.set_task(root, " ".join(rest), agent, session)
        print("작업 목표를 기록했습니다.")
    elif command == "checkpoint":
        if not rest:
            raise core.RondoError("사용법: rondo checkpoint \"핵심 상태\"")
        agent, session = current_identity()
        core.checkpoint(root, " ".join(rest), agent, session)
        print("체크포인트를 기록하고 Relay에 공개했습니다.")
    elif command == "next":
        agent, session = current_identity()
        requested = rest[0].lower() if rest and rest[0].lower() in core.AGENTS else ""
        summary_parts = rest[1:] if requested else rest
        summary = " ".join(summary_parts) if summary_parts else latest_summary(root)
        os.environ.setdefault("RONDO_ZELLIJ_SESSION", core.session_name(root))
        result = core.handoff(root, agent, session, summary, requested)
        print("%s -> %s 인계%s" % (
            core.display_name(agent) if agent else "User", core.display_name(result["to"]),
            " 완료" if result["delivered"] else " 메시지를 Relay에 기록했습니다",
        ))
    elif command == "message":
        if len(rest) < 2:
            raise core.RondoError("사용법: rondo message <claude|codex|gemini> \"메시지\"")
        recipient = core.normalize_agent(rest[0])
        text = " ".join(rest[1:])
        agent, session = current_identity()
        sender = core.display_name(agent) if agent else "User"
        message = core.append_message(root, sender, core.display_name(recipient), text, "message", session)
        state = core.load_state(root)
        targets = [
            sid for sid, data in state["sessions"].items()
            if data.get("agent") == recipient and data.get("status") == "active"
        ]
        os.environ.setdefault("RONDO_ZELLIJ_SESSION", core.session_name(root))
        delivery_error = ""
        try:
            delivered = bool(targets and core.deliver_to_session(root, targets[-1], message["text"]))
        except core.RondoError as error:
            delivered = False
            delivery_error = str(error)
        if delivered:
            print("%s 화면에 직접 입력했습니다. Relay에는 사본을 남겼습니다." % core.display_name(recipient))
        else:
            print("%s 화면에 직접 입력하지 못했습니다. Relay에 사본을 남겼습니다." % core.display_name(recipient))
            if delivery_error:
                print("원인: %s" % delivery_error)
    elif command == "request-review":
        agent, session = current_identity()
        requested = rest[0] if rest else ""
        os.environ.setdefault("RONDO_ZELLIJ_SESSION", core.session_name(root))
        review = core.request_review(root, agent, session, requested)
        spawned = False
        if not review.get("reviewer"):
            spawned = spawn_reviewer(root, review["agent"])
        print("독립 검증을 %s에 요청했습니다%s." % (
            core.display_name(review["agent"]), "" if review.get("delivered") or spawned else " (Relay 메시지 대기 중)"
        ))
    elif command == "review":
        if len(rest) < 2:
            raise core.RondoError("사용법: rondo review pass|fail \"검증 요약\"")
        agent, session = current_identity()
        result = core.record_review(root, rest[0].lower(), " ".join(rest[1:]), agent, session)
        print("독립 검증 결과: %s" % result["status"])
    elif command == "status":
        show_status(root)
    else:
        raise core.RondoError("알 수 없는 명령입니다: %s\n\n%s" % (command, HELP))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except core.RondoError as error:
        print("rondo: %s" % error, file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        print("\nrondo: 취소했습니다.", file=sys.stderr)
        raise SystemExit(130)
