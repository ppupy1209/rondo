def system_language() -> str:
    value = " ".join(os.environ.get(k, "") for k in ("LC_ALL", "LC_MESSAGES", "LANG"))
    return "ko" if re.search(r"(^|[_. ])ko([_. ]|$)", value, re.I) else "en"


def read_setting(name: str, default: str = "") -> str:
    try:
        return (CONFIG_DIR / name).read_text().strip()
    except OSError:
        return default


def language() -> str:
    forced = os.environ.get("RONDO_LANG", "").lower()
    if forced in TEXT:
        return forced
    saved = read_setting("language")
    return saved if saved in TEXT else system_language()


LANGUAGE = language()


def t(key: str, **values: object) -> str:
    return TEXT[LANGUAGE][key].format(**values)


def write_setting(name: str, value: str) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    target = CONFIG_DIR / name
    temp = target.with_name(f"{target.name}.{os.getpid()}.tmp")
    temp.write_text(value.rstrip() + "\n")
    os.chmod(temp, 0o600)
    temp.replace(target)


def migrate_legacy_config() -> None:
    if (CONFIG_DIR / "panels").exists() or not (LEGACY_CONFIG / "panels").exists():
        return
    try:
        panels = (LEGACY_CONFIG / "panels").read_text().strip().split()
    except OSError:
        return
    panels = [name for name in panels if name in AGENTS][:MAX_PANELS]
    if panels:
        write_setting("panels", " ".join(panels))
        write_setting("language", system_language())
        write_setting("audience", "default")
        write_setting("approval", "ask")
        write_setting("relay", "ready")
        write_setting("threshold", "1")


def installed(name: str) -> bool:
    return shutil.which(AGENTS[name][1]) is not None


def _read_key() -> str:
    if WINDOWS:
        first = msvcrt.getwch()
        if first == "\x03":
            raise KeyboardInterrupt
        if first in ("\x00", "\xe0"):
            return {"H": "\x1b[A", "P": "\x1b[B"}.get(msvcrt.getwch(), "")
        return first
    first = sys.stdin.buffer.read(1)
    if first == b"\x03":
        raise KeyboardInterrupt
    if first == b"\x1b":
        return (first + sys.stdin.buffer.read(2)).decode("ascii", "ignore")
    return first.decode("utf-8", "ignore")


def _draw(title: str, rows: list[str], hint: str = "") -> None:
    sys.stdout.write("\x1b[2J\x1b[H" + title + "\n\n" + "\n".join(rows))
    if hint:
        sys.stdout.write("\n\n" + hint)
    sys.stdout.flush()


def choose_one(title: str, options: list[tuple[str, str]], default: int = 0) -> str:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise RuntimeError(t("need_tty"))
    current = default
    old = termios.tcgetattr(sys.stdin.fileno()) if not WINDOWS else None
    sys.stdout.write("\x1b[?25l")
    try:
        if not WINDOWS:
            tty.setcbreak(sys.stdin.fileno())
        while True:
            rows = [f"  {'›' if i == current else ' '} {label}" for i, (_, label) in enumerate(options)]
            _draw(title, rows, "↑/↓ · Enter")
            key = _read_key()
            if key in ("\x1b[A", "k"):
                current = (current - 1) % len(options)
            elif key in ("\x1b[B", "j"):
                current = (current + 1) % len(options)
            elif key in ("\r", "\n"):
                return options[current][0]
    finally:
        if old is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[2J\x1b[H\x1b[?25h")
        sys.stdout.flush()


def choose_agents(defaults: set[str], title: str | None = None) -> list[str]:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        value = os.environ.get("RONDO_PANELS", "")
        names = value.replace(",", " ").split()
        valid = list(dict.fromkeys(
            name for name in names if name in AGENTS and installed(name)
        ))
        if not valid:
            raise RuntimeError(t("need_tty"))
        if len(valid) > MAX_PANELS:
            raise RuntimeError(t("max_panels", max=MAX_PANELS))
        return valid

    names = list(AGENTS)
    selected_names = [name for name in names if name in defaults and installed(name)]
    selected = set(selected_names[:MAX_PANELS])
    current = 0
    notice = ""
    title = title or t("agent_title")
    old = termios.tcgetattr(sys.stdin.fileno()) if not WINDOWS else None
    sys.stdout.write("\x1b[?25l")
    try:
        if not WINDOWS:
            tty.setcbreak(sys.stdin.fileno())
        while True:
            rows = []
            for i, name in enumerate(names):
                available = installed(name)
                mark = "●" if name in selected else "○"
                state = t("installed") if available else t("missing")
                cursor = "›" if i == current else " "
                rows.append(f"  {cursor} {mark} {name:<8} {AGENTS[name][2]:<24} {state}")
            _draw(title, rows, notice or t("agent_hint", max=MAX_PANELS))
            key = _read_key()
            if key in ("\x1b[A", "k"):
                current = (current - 1) % len(names)
            elif key in ("\x1b[B", "j"):
                current = (current + 1) % len(names)
            elif key == " ":
                name = names[current]
                if installed(name):
                    if name in selected:
                        selected.remove(name)
                        notice = ""
                    elif len(selected) >= MAX_PANELS:
                        notice = t("max_panels", max=MAX_PANELS)
                    else:
                        selected.add(name)
                        notice = ""
            elif key in ("\r", "\n") and selected:
                return [name for name in names if name in selected]
            elif key in ("\r", "\n"):
                _draw(title, rows, t("none"))
    finally:
        if old is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[2J\x1b[H\x1b[?25h")
        sys.stdout.flush()


def relay_options() -> list[tuple[str, str]]:
    values = [
        ("off", f"{t('relay_off')} — {t('relay_off_desc')}"),
        ("ready", f"{t('relay_ready')} — {t('relay_ready_desc')}"),
    ]
    if installed("codex"):
        values.append(("auto", f"{t('relay_auto')} — {t('relay_auto_desc')}"))
    return values


def audience_options() -> list[tuple[str, str]]:
    return [
        ("default", f"{t('audience_default')} — {t('audience_default_desc')}"),
        ("nondev", f"{t('audience_nondev')} — {t('audience_nondev_desc')}"),
        ("guided", f"{t('audience_guided')} — {t('audience_guided_desc')}"),
    ]


def approval_options() -> list[tuple[str, str]]:
    return [
        ("ask", f"{t('approval_ask')} — {t('approval_ask_desc')}"),
        ("workspace", f"{t('approval_workspace')} — {t('approval_workspace_desc')}"),
    ]


def setup() -> None:
    global LANGUAGE
    migrate_legacy_config()
    requested_language = os.environ.get("RONDO_LANG", "").lower()
    if requested_language in TEXT:
        LANGUAGE = requested_language
    else:
        LANGUAGE = choose_one(
            TEXT[LANGUAGE]["language_title"],
            [("ko", "한국어"), ("en", "English")],
            0 if LANGUAGE == "ko" else 1,
        )

    requested_audience = os.environ.get("RONDO_AUDIENCE", "").lower()
    current_audience = audience_lib.selected(CONFIG_DIR)
    if requested_audience in audience_lib.MODES:
        audience = requested_audience
    elif not (sys.stdin.isatty() and sys.stdout.isatty()):
        audience = current_audience
    else:
        options = audience_options()
        default = next(i for i, item in enumerate(options) if item[0] == current_audience)
        audience = choose_one(t("audience_title"), options, default)

    requested_approval = os.environ.get("RONDO_APPROVAL", "").lower()
    current_approval = approval_lib.selected(CONFIG_DIR)
    if requested_approval in approval_lib.MODES:
        approval = requested_approval
    elif not (sys.stdin.isatty() and sys.stdout.isatty()):
        approval = current_approval
    else:
        options = approval_options()
        default = next(i for i, item in enumerate(options) if item[0] == current_approval)
        approval = choose_one(t("approval_title"), options, default)

    saved = set(read_setting("panels").split())
    defaults = saved or {name for name in DEFAULT_AGENTS if installed(name)}
    panels = choose_agents(defaults)

    requested_relay = os.environ.get("RONDO_RELAY", "").lower()
    valid_modes = {value for value, _ in relay_options()}
    if requested_relay in valid_modes:
        relay = requested_relay
    elif not (sys.stdin.isatty() and sys.stdout.isatty()):
        relay = "ready"
    else:
        current = read_setting("relay", "ready")
        options = relay_options()
        default = next((i for i, item in enumerate(options) if item[0] == current), 1)
        relay = choose_one(t("relay_title"), options, default)
    if relay == "auto" and ("codex" not in panels or not installed("codex")):
        raise RuntimeError(t("select_auto_no_codex"))

    write_setting("language", LANGUAGE)
    write_setting("audience", audience)
    write_setting("approval", approval)
    write_setting("panels", " ".join(panels))
    write_setting("relay", relay)
    write_setting("threshold", "1")
    print(f"✓ {t('saved')}")
    print(f"  {t('language')}: {'한국어' if LANGUAGE == 'ko' else 'English'}")
    print(f"  {t('audience')}: {audience}")
    print(f"  {t('approval')}: {approval}")
    print(f"  {t('panels')}: {' '.join(panels)}")
    print(f"  {t('relay')}: {relay}")
    print(t("login"))


def repo_root() -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
        )
    except OSError:
        return Path.cwd()
    return Path(result.stdout.strip()) if result.returncode == 0 else Path.cwd()


def safe_session_name(value: str) -> str:
    name = re.sub(r"[^A-Za-z0-9_.-]+", "-", value).strip("-.")
    return name[:80] or "rondo"


def kdl_string(value: object) -> str:
    return json.dumps(value, ensure_ascii=False)


def in_zellij() -> bool:
    return bool(os.environ.get("ZELLIJ_SESSION_NAME") or os.environ.get("ZELLIJ"))


def git_origin(root: Path) -> str:
    try:
        result = subprocess.run(
            ["git", "-C", str(root), "remote", "get-url", "origin"],
            capture_output=True,
            text=True,
            timeout=5,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    value = result.stdout.strip().rstrip("/") if result.returncode == 0 else ""
    value = re.sub(r"^(https?://)[^/@]+@", r"\1", value, flags=re.I)
    return value[:-4] if value.endswith(".git") else value


def git_output(root: Path, *args: str, limit: int = 12_000) -> str:
    try:
        result = subprocess.run(
            ["git", "-C", str(root), *args],
            capture_output=True,
            text=True,
            timeout=8,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return result.stdout.strip()[:limit] if result.returncode == 0 else ""


def working_tree_status(root: Path) -> str:
    from rondo.proof import generated_path

    rows = []
    for row in git_output(root, "status", "--short").splitlines():
        path = row[3:].split(" -> ")[-1].strip('"') if len(row) > 3 else ""
        if path and not generated_path(path):
            rows.append(row)
    return "\n".join(rows)


def git_policy(root: Path) -> str:
    value = git_output(root, "config", "--local", "--get", "rondo.prPolicy")
    return value if value in GIT_POLICIES else "direct"


def git_reviewers(root: Path) -> list[str]:
    value = git_output(root, "config", "--local", "--get", "rondo.reviewers")
    names = value.replace(",", " ").split()
    return list(dict.fromkeys(name for name in names if name in AGENTS))[:MAX_PANELS]


def default_branch(root: Path) -> str:
    value = git_output(root, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    return value.removeprefix("origin/") if value else "main"


def rondo_session_name(root: Path, custom_name: str | None = None) -> str:
    identity = f"{git_origin(root) or 'local'}\0{root.resolve()}"
    digest = hashlib.sha256(identity.encode()).hexdigest()[:10]
    label = safe_session_name(custom_name or root.name)
    label = label[: MAX_SESSION_NAME_CHARS - len("rondo--") - len(digest)]
    return f"rondo-{label}-{digest}"


def configure_zellij_socket() -> None:
    if not WINDOWS:
        os.environ.setdefault("ZELLIJ_SOCKET_DIR", f"/tmp/rondo-{os.getuid()}")


def parse_session_list(value: str) -> tuple[set[str], set[str]]:
    active: set[str] = set()
    exited: set[str] = set()
    for line in value.splitlines():
        name = line.split(maxsplit=1)[0] if line.strip() else ""
        if not name:
            continue
        (exited if "(EXITED" in line else active).add(name)
    return active, exited


def zellij_sessions() -> tuple[set[str], set[str]]:
    result = subprocess.run(
        ["zellij", "list-sessions", "-n"], capture_output=True, text=True
    )
    return parse_session_list(result.stdout)


def configured_panels() -> list[str]:
    values = read_setting("panels").split()
    if (
        not values
        or len(values) > MAX_PANELS
        or any(name not in AGENTS for name in values)
    ):
        raise RuntimeError(t("bad_config"))
    return values


def pane_command(name: str) -> str:
    if not WINDOWS:
        return AGENTS[name][0]
    return AGENTS[name][0] + ".cmd"


def write_layout(panels: list[str]) -> Path:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    target = CACHE_DIR / "layout.kdl"
    first, rest = panels[0], panels[1:]
    status_command = "rondo-status.cmd" if WINDOWS else "rondo-status"
    lines = [
        "layout {",
        '    tab name="agents" focus=true {',
        f'        pane name="status" command="{status_command}" size=1 borderless=true',
        '        pane split_direction="vertical" {',
        f'            pane name="{first}" command={kdl_string(pane_command(first))} size="50%"',
    ]
    if rest:
        lines.append('            pane split_direction="horizontal" {')
        lines.extend(
            f'                pane name="{name}" command={kdl_string(pane_command(name))}' for name in rest
        )
        lines.append("            }")
    lines.extend(["        }", "    }", '    tab name="shell"', "}"])
    temp = target.with_suffix(".tmp")
    temp.write_text("\n".join(lines) + "\n")
    temp.replace(target)
    return target


def list_sessions() -> None:
    active, exited = zellij_sessions()
    names = sorted(name for name in active | exited if name.startswith("rondo-"))
    if not names:
        print(t("session_none"))
        return
    root = repo_root()
    current = rondo_session_name(root) if git_output(root, "rev-parse", "--is-inside-work-tree") == "true" else ""
    for name in names:
        state = "active" if name in active else "exited"
        suffix = f" · {t('session_current')}" if name == current else ""
        print(f"{name} · {state}{suffix}")


def kill_session(name: str | None) -> None:
    target = name or rondo_session_name(repo_root())
    if not target.startswith("rondo-") or any(char in target for char in "\r\n\0"):
        raise RuntimeError(t("kill_usage"))
    active, exited = zellij_sessions()
    if target not in active | exited:
        raise RuntimeError(t("session_none"))
    subprocess.run(["zellij", "delete-session", "--force", target], check=True)
    print(t("session_killed", name=target))


def clean_cache() -> int:
    removed = 0
    for path in CACHE_DIR.glob("claude.*.json"):
        try:
            project = Path(json.loads(path.read_text()).get("project", ""))
        except (OSError, ValueError, TypeError):
            continue
        if str(project) and not project.exists():
            path.unlink(missing_ok=True)
            removed += 1

    for section in ("proof", "race", "relay", "test"):
        directory = CACHE_DIR / section
        if not directory.is_dir():
            continue
        for item in directory.iterdir():
            if not item.is_dir() or item.is_symlink():
                continue
            roots = []
            for state in item.glob("*.json"):
                try:
                    value = json.loads(state.read_text())
                except (OSError, ValueError, TypeError):
                    continue
                root = value.get("root") or value.get("project")
                if root:
                    roots.append(Path(root))
            empty = not any(item.iterdir())
            if empty or (roots and all(not root.exists() for root in roots)):
                shutil.rmtree(item)
                removed += 1
    print(t("cache_cleaned", count=removed))
    return removed


def resume_prompt(path: Path) -> str:
    if LANGUAGE == "ko":
        return f"[Rondo resume] 다음 인계 파일을 읽고 현재 작업을 이어서 완료하세요: {path}"
    return f"[Rondo resume] Read this handoff file and continue the current work: {path}"


def open_session(resume_agent: str | None = None, handoff: Path | None = None) -> None:
    migrate_legacy_config()
    if shutil.which("zellij") is None:
        raise RuntimeError(t("not_installed", name="zellij"))
    root = repo_root()
    require_git_repo(root)
    os.environ["RONDO_GIT_POLICY"] = git_policy(root)
    name = rondo_session_name(root)
    active, exited = zellij_sessions()
    if name in active:
        if resume_agent and handoff:
            send_agent_message(resume_agent, [resume_prompt(handoff)], session_name=name)
        os.execvp("zellij", ["zellij", "attach", name])
    if not (CONFIG_DIR / "panels").exists():
        setup()
    panels = configured_panels()
    unavailable = [name for name in panels if not installed(name)]
    if unavailable:
        print(t("agents_skipped", names=", ".join(unavailable)), file=sys.stderr)
    panels = [name for name in panels if name not in unavailable]
    if not panels:
        raise RuntimeError(t("no_available_agents"))
    layout = write_layout(panels)
    print(f"{t('panels')}: {' '.join(panels)}")
    os.chdir(root)
    if name in exited:
        os.execvp(
            "zellij", ["zellij", "attach", "--force-run-commands", name]
        )
    os.execvp("zellij", ["zellij", "-s", name, "-n", str(layout)])


def add_agent(name: str | None) -> None:
    if not name:
        choices = [(key, f"{key} — {value[2]}") for key, value in AGENTS.items() if installed(key)]
        name = choose_one(t("agent_title"), choices)
    if name not in AGENTS:
        raise RuntimeError(t("unknown", name=name))
    if not installed(name):
        raise RuntimeError(t("not_installed", name=name))
    if not in_zellij():
        raise RuntimeError(t("need_zellij"))
    panes = agent_panes()
    if name in panes:
        raise RuntimeError(t("pane_exists", name=name))
    if len(panes) >= MAX_PANELS:
        raise RuntimeError(t("max_panels", max=MAX_PANELS))
    subprocess.run(["zellij", "action", "go-to-tab-name", "agents"], check=False)
    subprocess.run(["zellij", "action", "move-focus", "down"], check=False)
    os.execvp(
        "zellij",
        ["zellij", "action", "new-pane", "--name", name, "--", pane_command(name)],
    )


def agent_panes(session_name: str | None = None) -> dict[str, str]:
    command = ["zellij"]
    if session_name:
        command += ["-s", session_name]
    command += ["action", "list-panes", "--json"]
    result = subprocess.run(
        command,
        capture_output=True,
        text=True,
        check=True,
    )
    try:
        panes = json.loads(result.stdout)
    except (json.JSONDecodeError, TypeError):
        raise RuntimeError(t("pane_lookup_failed")) from None
    found: dict[str, str] = {}
    for pane in panes:
        if (
            pane.get("tab_name") == "agents"
            and not pane.get("is_plugin")
            and not pane.get("exited")
        ):
            title = str(pane.get("title", "")).casefold()
            if title in AGENTS:
                found[title] = str(pane["id"])
    return found


def find_agent_pane(name: str, session_name: str | None = None) -> str:
    pane = agent_panes(session_name).get(name.casefold())
    if pane:
        return pane
    raise RuntimeError(t("pane_missing", name=name))


def wait_for_agent_pane(name: str, session_name: str | None = None, wait: float = 4.0) -> str:
    deadline = time.monotonic() + wait
    while True:
        try:
            return find_agent_pane(name, session_name)
        except RuntimeError:
            if time.monotonic() >= deadline:
                raise
            time.sleep(0.2)


def pane_screen(command: list[str], pane: str) -> str:
    result = subprocess.run(
        command + ["action", "dump-screen", "--pane-id", pane],
        capture_output=True,
        text=True,
        check=True,
        timeout=10,
    )
    return result.stdout


def _blocked_screen(screen: str) -> bool:
    lowered = " ".join(screen.casefold().split())
    return any(pattern in lowered for pattern in BLOCKING_PROMPTS) or (
        "yes, i trust this folder" in lowered
        and ("enter to confirm" in lowered or "no, exit" in lowered)
    ) or (
        any(pattern in lowered for pattern in DECISION_PROMPTS)
        and ("enter to confirm" in lowered or "esc to cancel" in lowered)
    ) or (
        "enter to confirm" in lowered and "esc to cancel" in lowered
    ) or (
        "enter to select" in lowered and ("arrow" in lowered or "esc" in lowered)
    )


def _send_to_pane(name: str, pane: str, message: str, command: list[str]) -> None:
    before = pane_screen(command, pane)
    if _blocked_screen(before):
        raise PaneNotReady(t("pane_not_ready", name=name))
    subprocess.run(
        command + ["action", "paste", "--pane-id", pane, "--", message], check=True
    )
    token = re.sub(r"\s+", "", message)[-48:]
    deadline = time.monotonic() + 1.5
    while time.monotonic() < deadline:
        screen = pane_screen(command, pane)
        if _blocked_screen(screen):
            subprocess.run(
                command + ["action", "send-keys", "--pane-id", pane, "Esc"], check=False
            )
            raise PaneNotReady(t("pane_not_ready", name=name))
        tail = "\n".join(screen.splitlines()[-8:])
        if screen != before and token and token in re.sub(r"\s+", "", tail):
            break
        time.sleep(0.1)
    else:
        subprocess.run(
            command + ["action", "send-keys", "--pane-id", pane, "Esc"], check=False
        )
        raise RuntimeError(t("delivery_unverified", name=name))
    subprocess.run(
        command + ["action", "send-keys", "--pane-id", pane, "Enter"], check=True
    )


def send_agent_message(
    name: str | None, parts: list[str], session_name: str | None = None
) -> None:
    if name not in AGENTS:
        raise RuntimeError(t("send_usage") if not name else t("unknown", name=name))
    if not session_name and not in_zellij():
        raise RuntimeError(t("need_zellij"))
    message = " ".join(parts).strip().replace("\0", "")
    if not message:
        raise RuntimeError(t("empty_message"))
    if len(message) > MAX_AGENT_MESSAGE_CHARS:
        raise RuntimeError(t("message_too_long", max=MAX_AGENT_MESSAGE_CHARS))
    pane = wait_for_agent_pane(name, session_name)
    command = ["zellij"]
    if session_name:
        command += ["-s", session_name]
    _send_to_pane(name, pane, message, command)
    print(t("sent", name=name))


def change_language() -> None:
    global LANGUAGE
    selected = os.environ.get("RONDO_LANG", "").lower()
    if selected not in TEXT:
        selected = choose_one(
            t("language_title"),
            [("ko", "한국어"), ("en", "English")],
            0 if LANGUAGE == "ko" else 1,
        )
    LANGUAGE = selected
    write_setting("language", selected)
    print(f"✓ {t('language')}: {'한국어' if selected == 'ko' else 'English'}")


def audience_command(mode: str | None) -> None:
    if mode is None:
        current = audience_lib.selected(CONFIG_DIR)
        options = audience_options()
        default = next(i for i, item in enumerate(options) if item[0] == current)
        mode = choose_one(t("audience_title"), options, default)
    if mode not in audience_lib.MODES:
        raise RuntimeError(t("audience_usage"))
    write_setting("audience", mode)
    print(t("audience_saved", mode=mode))

    delivered = 0
    if in_zellij():
        open_names = [name for name in configured_panels() if name in agent_panes()]
        if open_names:
            print(t("audience_cost", count=len(open_names)))
        for name in open_names:
            try:
                send_agent_message(name, [audience_lib.update_prompt(mode)])
            except RuntimeError:
                continue
            delivered += 1
    if delivered:
        print(t("audience_applied", count=delivered))


def relay_index() -> dict | None:
    key = hashlib.sha256(str(repo_root().resolve()).encode()).hexdigest()[:16]
    index = CACHE_DIR / "relay" / key / "pending.json"
    try:
        return json.loads(index.read_text())
    except (OSError, ValueError, TypeError):
        return None


def packet_path() -> Path | None:
    info = relay_index()
    try:
        if info.get("status") != "ready":
            return None
        value = info.get("packet")
        path = Path(value)
        return path if path.exists() else None
    except (AttributeError, TypeError):
        return None


def relay_command(mode: str | None) -> None:
    valid = {"off", "ready", "auto"}
    if mode:
        if mode not in valid:
            raise RuntimeError("relay mode: off | ready | auto")
        if mode == "auto" and (
            not installed("codex") or "codex" not in read_setting("panels").split()
        ):
            raise RuntimeError(t("select_auto_no_codex"))
        write_setting("relay", mode)
        print(t("relay_mode_saved", mode=mode))
        return
    current = read_setting("relay", "ready")
    threshold = read_setting("threshold", "1")
    print(t("relay_status", mode=current, threshold=threshold))
    info = relay_index()
    pending = packet_path()
    if pending:
        print(t("relay_packet", path=pending))
    elif info:
        log = f" · {info['log']}" if info.get("log") else ""
        print(t("relay_last", status=info.get("status", "unknown"), log=log))
    else:
        print(t("relay_empty"))


def continue_relay() -> None:
    exec_script("rondo-relay", "--continue")


def handoff_command(parts: list[str]) -> int:
    root = repo_root()
    note = " ".join(parts).strip()
    if not note and sys.stdin.isatty():
        note = input(t("handoff_note")).strip()
    if not note:
        note = "Inspect the current branch and working tree, then continue the latest task."

    target = root / ".rondo" / "handoff.md"
    branch = git_output(root, "branch", "--show-current") or "(detached)"
    head = git_output(root, "rev-parse", "--short", "HEAD") or "-"
    status = working_tree_status(root) or "clean"
    diff = git_output(root, "diff", "--stat") or "no unstaged diff"
    commits = git_output(root, "log", "-5", "--pretty=format:%h %s") or "-"
    document = f"""# Rondo Handoff

> Updated: {time.strftime('%Y-%m-%d %H:%M:%S %z')}

## Next task

{note}

## Repository

- Origin: {git_origin(root) or '(none)'}
- Branch: {branch}
- HEAD: {head}

## Working tree

```text
{status}
```

### Unstaged diff summary

```text
{diff}
```

### Recent commits

```text
{commits}
```
"""
    target.parent.mkdir(parents=True, exist_ok=True)
    temp = target.with_suffix(".tmp")
    temp.write_text(document)
    temp.replace(target)
    panels = read_setting("panels").split()
    suggested = next((name for name in panels if name in ("claude", "codex")), "codex")
    print(t("handoff_saved", path=target.relative_to(root), agent=suggested))
    return 0


def resume_command(name: str | None) -> None:
    migrate_legacy_config()
    if not (CONFIG_DIR / "panels").exists():
        setup()
    panels = configured_panels()
    choices = [agent for agent in panels if agent in ("claude", "codex") and installed(agent)]
    if name is None:
        if not choices:
            raise RuntimeError(t("resume_unsupported", name="-"))
        name = choices[0] if len(choices) == 1 else choose_one(
            t("resume_agent"), [(agent, AGENTS[agent][2]) for agent in choices]
        )
    if name not in ("claude", "codex"):
        raise RuntimeError(t("resume_unsupported", name=name))
    if name not in panels:
        raise RuntimeError(t("pane_missing", name=name))
    if not installed(name):
        raise RuntimeError(t("not_installed", name=name))

    handoff = repo_root() / ".rondo" / "handoff.md"
    if not handoff.is_file():
        raise RuntimeError(t("handoff_missing"))
    os.environ["RONDO_RESUME_AGENT"] = name
    os.environ["RONDO_HANDOFF_FILE"] = str(handoff)
    os.environ["RONDO_LANG"] = LANGUAGE
    open_session(resume_agent=name, handoff=handoff)


def _command_options(
    args: list[str], valued: set[str], switches: set[str] | None = None
) -> tuple[list[str], dict[str, list[str]], set[str]]:
    bare: list[str] = []
    values = {name: [] for name in valued}
    enabled: set[str] = set()
    switches = switches or set()
    index = 0
    while index < len(args):
        value = args[index]
        if value in valued:
            if index + 1 >= len(args):
                raise ValueError(f"{value} requires a value")
            values[value].append(args[index + 1])
            index += 2
        elif value in switches:
            enabled.add(value)
            index += 1
        elif value.startswith("--"):
            raise ValueError(f"unknown option: {value}")
        else:
            bare.append(value)
            index += 1
    return bare, values, enabled


def task_command(args: list[str]) -> int:
    from rondo import proof as proof_lib

    try:
        bare, values, _ = _command_options(
            args, {"--accept", "--avoid", "--scope", "--check"}
        )
        checks = [shlex.split(value, posix=not WINDOWS) for value in values["--check"]]
        task = proof_lib.record_task(
            repo_root(),
            " ".join(bare),
            acceptance=values["--accept"],
            must_not=values["--avoid"],
            scope=values["--scope"],
            checks=checks,
        )
    except ValueError:
        print(t("task_usage"), file=sys.stderr)
        return 1
    print(t(
        "task_saved",
        acceptance=len(task["acceptance"]),
        must_not=len(task["must_not"]),
    ))
    return 0


def _reviewer_prompt(packet: Path) -> str:
    if LANGUAGE == "ko":
        return (
            "[Rondo Proof · 독립 검증] 구현 코드를 수정하지 마세요. 증거 패킷과 실제 diff를 "
            "읽고 목표·성공 조건·금지 조건을 독립적으로 검증하세요. 가장 강한 반례부터 찾고, "
            f"확인되지 않은 항목은 통과로 간주하지 말고 결과를 이 패널에 표시하세요: {packet}"
        )
    return (
        "[Rondo Proof · independent verification] Do not edit implementation code. Read the "
        "evidence packet and actual diff, verify the goal, acceptance criteria, and constraints, "
        "look for the strongest counterexample first, and never pass unverified claims. Show the "
        f"result in this pane: {packet}"
    )


def start_proof_reviewer(name: str, packet: Path, root: Path) -> None:
    if name not in ("claude", "codex"):
        raise RuntimeError(t("proof_reviewer_usage", name=name))
    if not installed(name):
        raise RuntimeError(t("not_installed", name=name))
    if not in_zellij():
        raise RuntimeError(t("need_zellij"))

    binary = shutil.which(AGENTS[name][1]) or AGENTS[name][1]
    prompt = _reviewer_prompt(packet)
    vendor_args = (
        ["-s", "read-only", prompt]
        if name == "codex"
        else ["--permission-mode", "plan", prompt]
    )
    command = [binary, *vendor_args]
    if WINDOWS and Path(binary).suffix.lower() in (".cmd", ".bat"):
        command = [os.environ.get("COMSPEC", "cmd.exe"), "/d", "/c", *command]
    subprocess.run(
        [
            "zellij", "action", "new-pane", "--name", f"proof-{name}",
            "--cwd", str(root), "--", *command,
        ],
        check=True,
    )
    print(t("proof_reviewer_started", name=name))


def proof_command(args: list[str]) -> int:
    from rondo import proof as proof_lib

    try:
        bare, values, switches = _command_options(
            args, {"--reviewer"}, {"--no-checks"}
        )
    except ValueError as exc:
        raise RuntimeError(str(exc)) from None
    if bare:
        raise RuntimeError(f"unknown proof argument: {' '.join(bare)}")

    root = repo_root()
    proof = proof_lib.build(root, run_checks="--no-checks" not in switches)
    summary = proof["summary"]
    verdict = {
        "ready": t("proof_ready"),
        "review": t("proof_review"),
        "empty": t("proof_empty"),
    }[summary["verdict"]]
    print(t("proof_title", verdict=verdict))
    if summary["verdict"] == "empty":
        print("  " + t("proof_empty_hint"))
    print("  " + t("proof_checks", passed=summary["passed"], failed=summary["failed"]))
    print("  " + t(
        "proof_risk", files=summary["files"], high=summary["high"],
        medium=summary["medium"], low=summary["low"],
    ))
    print("  " + t("proof_human", count=len(proof["human"])))
    for item in proof["human"]:
        details = " · ".join(
            value for value in (
                item.get("reason", ""),
                f"{item['lines']} lines" if "lines" in item else "",
            ) if value
        )
        print(f"    ! {item['label']}{f' · {details}' if details else ''}")
    print("  " + t("proof_packet", path=proof["packet"]))

    reviewers = values["--reviewer"]
    if reviewers and summary["verdict"] != "empty":
        start_proof_reviewer(reviewers[-1], Path(proof["packet"]), root)
    return int(summary["failed"] > 0)


def review_command(args: list[str]) -> int:
    from rondo import proof as proof_lib

    try:
        bare, values, _ = _command_options(args, {"--budget"})
        if bare:
            raise ValueError("unexpected argument")
        budget = proof_lib.parse_budget(values["--budget"][-1]) if values["--budget"] else 120
    except ValueError:
        raise RuntimeError("review usage: rondo review [--budget 2m]") from None
    proof = proof_lib.latest(repo_root())
    if not proof:
        raise RuntimeError(t("proof_missing"))
    selected, deferred = proof_lib.review_queue(proof, budget)
    print(t("review_title", budget=budget))
    spent = sum(item["seconds"] for item in selected)
    if spent > budget:
        print("  ! " + t("review_over_budget", seconds=spent))
    if not selected:
        print(f"  ✓ {t('review_empty')}")
    for index, item in enumerate(selected, 1):
        mark = "!" if item["level"] == "high" else "·"
        details = " · ".join(
            value for value in (
                item.get("reason", ""),
                f"{item['lines']} lines" if "lines" in item else "",
            ) if value
        )
        print(f"  {index}. {mark} {item['label']}{f' · {details}' if details else ''}  ~{item['seconds']}s")
    if deferred:
        print("  " + t("review_deferred", count=len(deferred)))
    print("  " + t("proof_packet", path=proof["packet"]))
    return 0


def git_policy_options() -> list[tuple[str, str]]:
    return [
        ("direct", f"{t('git_policy_direct')} — {t('git_policy_direct_desc')}"),
        ("pr", f"{t('git_policy_pr')} — {t('git_policy_pr_desc')}"),
        ("review", f"{t('git_policy_review')} — {t('git_policy_review_desc')}"),
    ]


def require_git_repo(root: Path) -> None:
    if git_output(root, "rev-parse", "--is-inside-work-tree") != "true":
        raise RuntimeError(t("git_not_repo"))


def git_command(args: list[str]) -> int:
    root = repo_root()
    subcommand = args[0] if args else "status"
    if subcommand == "connect":
        values = [value for value in args[1:] if value != "--replace"]
        if len(values) != 1 or values[0].startswith("-") or any(
            char in values[0] for char in "\r\n\0"
        ):
            raise RuntimeError(t("git_usage"))
        origin = values[0]
        if git_output(root, "rev-parse", "--is-inside-work-tree") != "true":
            subprocess.run(
                ["git", "-C", str(root), "init", "-b", "main"],
                check=True, capture_output=True, text=True,
            )
        current = git_origin(root)
        if current and "--replace" not in args:
            raise RuntimeError(t("git_origin_exists", origin=current))
        action = ["set-url", "origin", origin] if current else ["add", "origin", origin]
        subprocess.run(["git", "-C", str(root), "remote", *action], check=True)
        print(t("git_connected", origin=origin))
        return 0

    require_git_repo(root)
    if subcommand == "policy":
        mode = args[1] if len(args) > 1 else None
        if mode is None:
            options = git_policy_options()
            current = git_policy(root)
            default = next(i for i, item in enumerate(options) if item[0] == current)
            mode = choose_one(t("git_policy_title"), options, default)
        if mode not in GIT_POLICIES or len(args) > 2:
            raise RuntimeError(t("git_usage"))
        subprocess.run(
            ["git", "-C", str(root), "config", "--local", "rondo.prPolicy", mode],
            check=True,
        )
        print(t("git_policy_saved", policy=mode))
        return 0

    if subcommand == "reviewers":
        if len(args) > 1:
            names = list(dict.fromkeys(
                name for value in args[1:] for name in value.replace(",", " ").split()
            ))
        else:
            defaults = set(git_reviewers(root) or configured_panels())
            names = choose_agents(defaults, t("git_reviewers_title"))
        if (
            not names
            or len(names) > MAX_PANELS
            or any(name not in AGENTS or not installed(name) for name in names)
        ):
            raise RuntimeError(t("review_agent_usage"))
        subprocess.run(
            ["git", "-C", str(root), "config", "--local", "rondo.reviewers", " ".join(names)],
            check=True,
        )
        print(t("git_reviewers_saved", reviewers=" ".join(names)))
        return 0

    if subcommand != "status" or len(args) > 1:
        raise RuntimeError(t("git_usage"))
    reviewers = git_reviewers(root) or configured_panels()
    print(t("git_status"))
    origin = git_origin(root)
    print(f"  {t('git_origin')}: {origin or '-'}")
    if not origin:
        print(f"  {t('git_connect_hint')}")
    print(f"  {t('git_branch')}: {git_output(root, 'branch', '--show-current') or '-'}")
    print(f"  {t('git_policy')}: {git_policy(root)}")
    print(f"  {t('git_reviewers')}: {' '.join(reviewers)}")
    return 0


def code_review_prompt(root: Path) -> str:
    base = default_branch(root)
    if LANGUAGE == "ko":
        return (
            f"[Rondo code review] 구현 코드를 수정하지 마세요. 현재 브랜치를 {base} 기준으로 "
            "독립 검토하세요. 실제 diff와 테스트를 확인하고, 실행 가능한 문제만 심각도 순으로 "
            "파일:줄, 영향, 수정 방법과 함께 보고하세요. 문제가 없으면 없다고 명확히 말하세요."
        )
    return (
        f"[Rondo code review] Do not modify implementation code. Independently review the current "
        f"branch against {base}. Inspect the actual diff and tests. Report only actionable findings "
        "in severity order with file:line, impact, and fix; explicitly say when none are found."
    )


def reviewer_argv(name: str, prompt: str) -> list[str]:
    binary = shutil.which(AGENTS[name][1]) or AGENTS[name][1]
    flags = {
        "claude": ["--permission-mode", "plan"],
        "codex": ["-s", "read-only"],
        "gemini": ["--mode", "plan", "--prompt-interactive"],
        "kimi": ["--plan"],
        "grok": ["--permission-mode", "plan"],
    }[name]
    command = [binary, *flags, prompt]
    if WINDOWS and Path(binary).suffix.lower() in (".cmd", ".bat"):
        return [os.environ.get("COMSPEC", "cmd.exe"), "/d", "/c", *command]
    return command


def command_layout(tab: str, panes: list[tuple[str, str, list[str]]]) -> str:
    def pane_lines(item: tuple[str, str, list[str]], indent: str) -> list[str]:
        name, cwd, command = item
        lines = [
            indent + "pane "
            f"name={kdl_string(name)} cwd={kdl_string(cwd)} command={kdl_string(command[0])} {{"
        ]
        if len(command) > 1:
            lines.append(indent + "    args " + " ".join(kdl_string(arg) for arg in command[1:]))
        lines.append(indent + "}")
        return lines

    lines = [
        "layout {",
        f"    tab name={kdl_string(tab)} focus=true split_direction=\"vertical\" {{",
    ]
    midpoint = (len(panes) + 1) // 2
    groups = [panes[:midpoint], panes[midpoint:]] if len(panes) > 1 else [panes]
    for group in groups:
        if not group:
            continue
        if len(group) == 1:
            lines += pane_lines(group[0], "        ")
        else:
            lines.append('        pane split_direction="horizontal" {')
            for item in group:
                lines += pane_lines(item, "            ")
            lines.append("        }")
    return "\n".join([*lines, "    }", "}"])


def code_review_command(args: list[str]) -> int:
    if not in_zellij():
        raise RuntimeError(t("need_zellij"))
    root = repo_root()
    require_git_repo(root)
    requested = args[0] if args else "all"
    if len(args) > 1 or requested not in (*AGENTS, "all"):
        raise RuntimeError(t("review_agent_usage"))
    reviewers = (
        git_reviewers(root) or configured_panels()
        if requested == "all"
        else [requested]
    )
    reviewers = [name for name in reviewers if installed(name)][:MAX_PANELS]
    if not reviewers:
        raise RuntimeError(t("review_agent_usage"))
    prompt = code_review_prompt(root)
    panes = [
        (f"review-{name}", str(root), reviewer_argv(name, prompt))
        for name in reviewers
    ]
    subprocess.run(
        ["zellij", "action", "new-tab", "--layout-string", command_layout("code-review", panes)],
        check=True,
    )
    print(t("review_agent_started", reviewers=" ".join(reviewers)))
    return 0


def test_agent_argv(name: str, prompt: str) -> list[str]:
    binary = shutil.which(AGENTS[name][1]) or AGENTS[name][1]
    permissions = approval_lib.arguments(name, approval_lib.selected(CONFIG_DIR))
    prompt_flags = ["--prompt-interactive"] if name == "gemini" else []
    command = [binary, *permissions, *prompt_flags, prompt]
    if WINDOWS and Path(binary).suffix.lower() in (".cmd", ".bat"):
        return [os.environ.get("COMSPEC", "cmd.exe"), "/d", "/c", *command]
    return command


def _testers(values: list[str]) -> list[str]:
    names = list(dict.fromkeys(
        name for value in values for name in value.replace(",", " ").split()
    ))
    if not names:
        defaults = set(git_reviewers(repo_root()) or configured_panels())
        names = choose_agents(defaults, t("test_tester_title"))
    if (
        not names
        or len(names) > MAX_PANELS
        or any(name not in AGENTS or not installed(name) for name in names)
    ):
        raise RuntimeError(t("test_usage"))
    return names


def _test_implementer(value: str | None) -> str:
    implementer = value or os.environ.get("RONDO_AGENT")
    if implementer:
        if implementer not in (*AGENTS, "human"):
            raise RuntimeError(t("test_usage"))
        return implementer
    return choose_one(
        t("test_implementer_title"),
        [("human", "human"), *[(name, AGENTS[name][2]) for name in AGENTS]],
    )


def test_layout(run) -> str:
    from rondo import testing as testing_lib

    panes: list[tuple[str, str, list[str]]] = []
    for profile, role in run.roles.items():
        prompt = testing_lib.role_prompt(run, profile, LANGUAGE)
        command = test_agent_argv(role["agent"], prompt)
        panes.append((f"test-{profile}-{role['agent']}", role["worktree"], command))
    return command_layout(f"test-{run.run_id}", panes)


def _launch_test_sessions(run) -> str:
    result = subprocess.run(
        ["zellij", "action", "new-tab", "--layout-string", test_layout(run)],
        check=True,
        capture_output=True,
        text=True,
    )
    return result.stdout.strip()


def _close_test_tab(run) -> None:
    if not run.tab_id:
        return
    owner = getattr(run, "zellij_session", "")
    environment = os.environ.copy()
    owner_socket = getattr(run, "zellij_socket", "")
    if owner_socket:
        environment["ZELLIJ_SOCKET_DIR"] = owner_socket
    listing = subprocess.run(
        ["zellij", "list-sessions", "-n"],
        capture_output=True,
        text=True,
        env=environment,
    )
    if listing.returncode:
        raise RuntimeError(listing.stderr.strip() or listing.stdout.strip() or t("pane_lookup_failed"))
    active, _exited = parse_session_list(listing.stdout)
    if owner and owner not in active:
        return
    if not owner and not in_zellij():
        raise RuntimeError(t("test_need_session"))
    command = ["zellij"]
    if owner:
        command += ["-s", owner]
    done = subprocess.run(
        [*command, "action", "close-tab", "--tab-id", run.tab_id],
        capture_output=True,
        text=True,
        env=environment,
    )
    if done.returncode:
        raise RuntimeError(done.stderr.strip() or done.stdout.strip() or t("test_need_session"))


def test_command(args: list[str]) -> int:
    from rondo import testing as testing_lib

    root = repo_root()
    if args and args[0] in {"status", "finish", "abort"}:
        if len(args) != 1:
            raise RuntimeError(t("test_usage"))
        run = testing_lib.load(root)
        if not run:
            print(t("test_none"))
            return 0
        if args[0] == "abort":
            _close_test_tab(run)
            testing_lib.abort(run)
            print(t("test_aborted"))
            return 0
        if args[0] == "finish":
            pending = [
                profile for profile, role in run.roles.items()
                if not testing_lib.report_complete(role["report"])
            ]
            if pending:
                raise RuntimeError(t("test_finish_pending", profiles=", ".join(pending)))
            _close_test_tab(run)
            result = testing_lib.finish(run)
            print(t("test_finished", path=result["summary"]))
            failed = any(not item["report"] or item["violations"] for item in result["results"])
            failed = failed or bool(run.load and run.load.get("status") != "passed")
            return int(failed)
        print(t("test_status", run=run.run_id, implementer=run.implementer))
        for profile, role in run.roles.items():
            state = (
                t("test_report_ready")
                if testing_lib.report_complete(role["report"])
                else t("test_report_pending")
            )
            print(f"  {profile}: {role['agent']} · {state}")
        if run.load:
            print("  " + t("test_load", status=run.load.get("status"), graph=run.load.get("graph") or "-"))
        return 0

    if not in_zellij():
        raise RuntimeError(t("test_need_session"))
    require_git_repo(root)
    try:
        profiles, values, switches = _command_options(
            args,
            {"--from", "--tester", "--url", "--script", "--vus", "--duration"},
            {"--allow-remote"},
        )
        profiles = testing_lib.expand_profiles(profiles)
        implementer = _test_implementer(values["--from"][-1] if values["--from"] else None)
        testers = _testers(values["--tester"])
        vus = int(values["--vus"][-1]) if values["--vus"] else 10
        duration = values["--duration"][-1] if values["--duration"] else "30s"
        url = values["--url"][-1] if values["--url"] else None
        script = values["--script"][-1] if values["--script"] else None
        testing_lib.validate_load_options(vus, duration)
        if "load" in profiles and not (url or script):
            raise ValueError("load requires a target")
        if url and not testing_lib.allowed_load_url(url, "--allow-remote" in switches):
            raise ValueError("remote load target blocked")
        if script and "--allow-remote" not in switches:
            raise ValueError("custom script target cannot be verified")
    except (ValueError, testing_lib.TestError):
        raise RuntimeError(t("test_usage")) from None

    implementer_session = os.environ.get("RONDO_AGENT_SESSION") or f"declared-{implementer}-{uuid.uuid4().hex}"
    run = testing_lib.start(root, profiles, implementer, implementer_session, testers)
    run.zellij_session = os.environ.get("ZELLIJ_SESSION_NAME", "")
    run.zellij_socket = os.environ.get("ZELLIJ_SOCKET_DIR", "")
    testing_lib.save(run)
    try:
        if url or script:
            result = testing_lib.run_load(
                run, url, script, vus, duration, "--allow-remote" in switches
            )
            print(t("test_load", status=result["status"], graph=result.get("graph") or "-"))
        run.tab_id = _launch_test_sessions(run)
        testing_lib.save(run)
    except Exception:
        _close_test_tab(run)
        testing_lib.abort(run)
        raise

    print(t("test_started", run=run.run_id, count=len(run.roles)))
    print(t("test_rule"))
    for profile, role in run.roles.items():
        print("  " + t(
            "test_role", profile=profile, agent=role["agent"], session=role["session"][:8]
        ))
    return 0


def pr_command(args: list[str]) -> int:
    root = repo_root()
    require_git_repo(root)
    if not git_origin(root):
        raise RuntimeError(t("git_no_origin"))
    if shutil.which("gh") is None:
        raise RuntimeError(t("not_installed", name="gh"))
    if git_output(root, "status", "--porcelain"):
        raise RuntimeError(t("pr_dirty"))
    branch = git_output(root, "branch", "--show-current")
    base = default_branch(root)
    if not branch or branch in {base, "main", "master"}:
        raise RuntimeError(t("pr_default_branch", branch=branch or base))
    subprocess.run(
        ["git", "-C", str(root), "push", "--set-upstream", "origin", branch],
        check=True,
    )
    command = ["gh", "pr", "create", "--fill"]
    if git_policy(root) == "review":
        command.append("--draft")
    if args:
        command += ["--title", " ".join(args)]
    subprocess.run(command, cwd=root, check=True)
    if git_policy(root) == "review":
        if in_zellij():
            code_review_command(["all"])
        else:
            print(t("pr_review_hint"))
    return 0


def open_lens(args: list[str]) -> None:
    exec_script("rondo-lens", *args)


def script_argv(name: str, *args: str) -> list[str]:
    script = Path(__file__).resolve().with_name(name)
    return [sys.executable, str(script), *args] if WINDOWS else [str(script), *args]


def exec_script(name: str, *args: str) -> None:
    argv = script_argv(name, *args)
    os.execv(argv[0] if WINDOWS else Path(argv[0]), argv)


def doctor(deep: bool = False) -> int:
    print(t("doctor_title"))
    required = [
        ("python", sys.executable, True),
        ("zellij", "zellij", True),
        ("git", "git", True),
        ("gh", "gh", False),
        ("docker", "docker", False),
    ]
    optional = [(name, False) for name in AGENTS]
    failed = False
    for item in required + optional:
        if len(item) == 3:
            name, executable, is_required = item
        else:
            name, is_required = item
            executable = AGENTS[name][1]
        path = shutil.which(executable)
        mark = "✓" if path else ("✗" if is_required else "–")
        state = t("doctor_ok") if path else t("doctor_missing" if is_required else "doctor_optional")
        print(f"  {mark} {name:<10} {state}{f' · {path}' if path else ''}")
        failed = failed or (is_required and not path)
    panels = read_setting("panels")
    print(f"  {'✓' if panels else '–'} {t('doctor_config'):<10} {panels or t('doctor_missing')}")
    regressed = deep_probe() if deep else False
    if not deep:
        print(t("doctor_deep_hint"))
    if failed:
        print(t("doctor_hint"))
    return int(failed or regressed)


def deep_probe() -> bool:
    """어댑터별로 지금 실제 읽히는지 확인하고, 벤더 업데이트로 깨진 것을 알린다.

    표시만 하는 진단이라 어댑터 import 실패가 doctor 전체를 죽이면 안 된다.
    """
    try:
        from rondo import registry
    except ImportError as exc:
        print(f"\n{t('doctor_deep_title')}: lib/rondo import 실패 ({exc})")
        return True

    root = repo_root()
    print(f"\n{t('doctor_deep_title')}")
    warnings: list[str] = []
    for adapter in registry.all_adapters():
        if not adapter.installed():
            continue
        version = adapter.version() or t("doctor_unknown_version")
        print(f"  {adapter.name} {version}")
        for check in adapter.diagnose(root):
            mark = "✓" if check.ok else "✗"
            print(f"    {mark} {check.capability:<10} {check.detail}")
        warnings.extend(registry.check_fingerprint(adapter, root))

    for warning in warnings:
        print(f"  ! {t('doctor_changed')}: {warning}")
    return bool(warnings)


RACE_TAB = "race"


def race_layout(race) -> str:
    """race 탭 KDL. 패널마다 자기 worktree 를 cwd 로 잡는다.

    *-session 래퍼가 아니라 원본 명령을 띄운다 — worktree 에서 handoff 를 돌리면 안 된다.
    """
    panes = [
        (f"race-{agent}", str(path), [shutil.which(AGENTS[agent][1]) or AGENTS[agent][1]])
        for agent, path in race.agents.items()
    ]
    return command_layout(RACE_TAB, panes)


def race_panes() -> dict[str, str]:
    """race 탭에 열려 있는 패널 이름 -> 패널 id."""
    try:
        result = subprocess.run(
            ["zellij", "action", "list-panes", "--json"],
            capture_output=True, text=True, check=False, timeout=5,
        )
        panes = json.loads(result.stdout)
    except (json.JSONDecodeError, TypeError, OSError, subprocess.SubprocessError):
        return {}
    found = {}
    for pane in panes:
        title = str(pane.get("title", ""))
        if pane.get("tab_name") == RACE_TAB and title.startswith("race-") and not pane.get("exited"):
            found[title[len("race-"):]] = str(pane["id"])
    return found


def race_send(race, wait: float = 4.0) -> int:
    """과제를 각 race 패널에 넣는다. 사람이 친 것과 같은 경로(paste + Enter)."""
    deadline = time.monotonic() + wait
    panes = race_panes()
    while len(panes) < len(race.agents) and time.monotonic() < deadline:
        time.sleep(0.3)
        panes = race_panes()
    sent = 0
    for agent, pane in panes.items():
        if agent not in race.agents:
            continue
        try:
            _send_to_pane(agent, pane, race.task, ["zellij"])
        except (OSError, RuntimeError, subprocess.SubprocessError):
            continue
        sent += 1
    return sent


def race_participants(requested: str | None) -> list[str]:
    """지정이 없으면 설정된 패널 중 설치됐고 한도가 남은 것만."""
    from rondo import race as race_lib
    from rondo import registry

    configured = [name for name in configured_panels() if name in AGENTS]
    if requested:
        wanted = [name.strip() for name in requested.split(",") if name.strip()]
        return [name for name in wanted if name in AGENTS and installed(name)]

    root = repo_root()
    snapshots = {}
    for name in configured:
        if not installed(name):
            continue
        adapter = registry.get(name)
        snapshots[name] = adapter.snapshot(root) if adapter else None

    joining, skipped = race_lib.eligible(snapshots)
    print(t("race_plan"))
    for name in configured:
        if name in joining:
            print(f"  {name}")
        elif name in skipped:
            print(f"  {name}  {t('race_skip', reason=skipped[name])}")
    return joining


def race_command(args: list[str]) -> int:
    from rondo import race as race_lib

    root = repo_root()
    if "--abort" in args:
        race = race_lib.load(root)
        if race is None:
            print(t("race_missing"), file=sys.stderr)
            return 1
        saved = race_lib.abort(race)
        print(t("race_aborted", count=len(saved)))
        return 0

    if "--status" in args:
        race = race_lib.load(root)
        if race is None:
            print(t("race_missing"))
            return 0
        print(t("race_started", run=race.run_id, base=race.base[:8]))
        print(f"  {race.task}")
        for row in race_lib.summary(race):
            print("  " + _race_row(row))
        return 0

    if "--send" in args:
        race = race_lib.load(root)
        if race is None:
            print(t("race_missing"), file=sys.stderr)
            return 1
        print(t("race_sent", count=race_send(race, wait=1.0)))
        return 0

    requested = None
    if "--agents" in args:
        index = args.index("--agents")
        requested = args[index + 1] if index + 1 < len(args) else None
        args = args[:index] + args[index + 2:]
    task = " ".join(a for a in args if not a.startswith("--")).strip()
    if not task:
        print(t("race_usage"), file=sys.stderr)
        return 1
    if not in_zellij():
        raise RuntimeError(t("need_zellij"))

    agents = race_participants(requested)
    if not agents:
        print(t("race_none"), file=sys.stderr)
        return 1
    if "--yes" not in args:
        answer = input(t("race_confirm", count=len(agents))).strip().lower()
        if answer not in ("y", "yes"):
            print(t("race_cancelled"))
            return 0

    race = race_lib.start(root, task, agents)
    print(t("race_started", run=race.run_id, base=race.base[:8]))
    try:
        subprocess.run(["zellij", "action", "new-tab", "--layout-string", race_layout(race)],
                       check=False, timeout=15)
    except (OSError, subprocess.SubprocessError):
        pass
    print(t("race_sent", count=race_send(race)))
    return 0


def _race_row(row: dict) -> str:
    if row.get("error"):
        return f"{row['agent']:<8} {row['error']}"
    return (f"{row['agent']:<8} {row['files']:>3} files  "
            f"+{row['added']:<5} -{row['removed']}")


def diff_command(agent: str | None) -> int:
    from rondo import race as race_lib

    race = race_lib.load(repo_root())
    if race is None:
        print(t("race_missing"), file=sys.stderr)
        return 1
    if agent:
        print(race_lib.diff_text(race, agent), end="")
        return 0
    print(t("race_started", run=race.run_id, base=race.base[:8]))
    print(f"  {race.task}\n")
    for row in race_lib.summary(race):
        print("  " + _race_row(row))
    return 0


def take_command(agent: str | None) -> int:
    from rondo import race as race_lib

    if not agent:
        print(t("take_usage"), file=sys.stderr)
        return 1
    race = race_lib.load(repo_root())
    if race is None:
        print(t("race_missing"), file=sys.stderr)
        return 1
    result = race_lib.take(race, agent)
    print(t("race_taken" if result["applied"] else "race_empty_take", name=agent))
    return 0


def snap_command(label: str | None) -> int:
    """--auto 는 훅에서 온 것이다. 아무것도 출력하지 않고, 실패해도 턴을 막지 않는다.

    (Claude 의 UserPromptSubmit 훅은 stdout 을 모델 컨텍스트에 넣는다.)
    """
    from rondo import undo as undo_lib
    from rondo.gitcmd import GitError

    quiet = label == "--auto"
    try:
        root = repo_root()
        snap = undo_lib.snapshot(root, "" if quiet else (label or ""))
    except (GitError, OSError) as exc:
        if quiet:
            return 0
        print(str(exc), file=sys.stderr)
        return 1
    if not quiet:
        print(t("snap_done", sha=snap.short, count=len(undo_lib.snapshots(root))))
    return 0


def undo_command(args: list[str]) -> int:
    from rondo import undo as undo_lib
    from rondo.gitcmd import GitError

    root = repo_root()
    history = undo_lib.snapshots(root)
    if args == ["--list"]:
        if not history:
            print(t("undo_none"))
            return 0
        print(t("undo_list"))
        for snap in history:
            when = time.strftime("%m-%d %H:%M", time.localtime(snap.at))
            print(f"  {snap.short}  {when}  {snap.label}")
        return 0

    if not history:
        print(t("undo_none"), file=sys.stderr)
        return 1
    yes = "--yes" in args
    values = [value for value in args if value != "--yes"]
    steps, target_id = 1, None
    if values:
        if values[0] == "--steps" and len(values) == 2 and values[1].isdigit():
            steps = int(values[1])
            if steps < 1:
                print(t("undo_usage"), file=sys.stderr)
                return 1
        elif len(values) == 1 and not values[0].startswith("-"):
            target_id = values[0]
        else:
            print(t("undo_usage"), file=sys.stderr)
            return 1
    try:
        target = undo_lib.find_snapshot(root, target_id) if target_id else history[steps - 1]
        changes = undo_lib.preview(root, target)
        print(t("undo_preview", target=target.short, count=len(changes)))
        for row in changes[:10]:
            print(f"  {row}")
        if changes and not yes:
            if not sys.stdin.isatty():
                print(t("undo_usage"), file=sys.stderr)
                return 1
            if input(t("undo_confirm")).strip().casefold() not in {"y", "yes"}:
                print(t("race_cancelled"))
                return 0
        result = undo_lib.undo(root, steps, target_id)
    except IndexError:
        print(t("undo_none"), file=sys.stderr)
        return 1
    except GitError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    if not result["undone"]:
        print(t("undo_noop"))
        return 0
    print(t("undo_done", target=result["target"], before=result["before"]))
    return 0


def main() -> int:
    configure_zellij_socket()
    args = sys.argv[1:]
    command = args[0] if args else ""
    if command in ("help", "-h", "--help"):
        print(t("usage"), end="")
    elif command in ("--version", "-V"):
        print(f"rondo {VERSION}")
    elif command in ("-l", "--list"):
        list_sessions()
    elif command == "kill":
        if len(args) > 2:
            raise RuntimeError(t("kill_usage"))
        kill_session(args[1] if len(args) > 1 else None)
    elif command == "clean":
        if len(args) > 1:
            raise RuntimeError("Usage: rondo clean")
        clean_cache()
    elif command == "setup":
        setup()
    elif command == "add":
        add_agent(args[1] if len(args) > 1 else None)
    elif command == "send":
        send_agent_message(args[1] if len(args) > 1 else None, args[2:])
    elif command == "handoff":
        return handoff_command(args[1:])
    elif command == "resume":
        resume_command(args[1] if len(args) > 1 else None)
    elif command == "task":
        return task_command(args[1:])
    elif command == "proof":
        return proof_command(args[1:])
    elif command == "review":
        return review_command(args[1:])
    elif command == "git":
        return git_command(args[1:])
    elif command == "code-review":
        return code_review_command(args[1:])
    elif command == "test":
        return test_command(args[1:])
    elif command == "pr":
        return pr_command(args[1:])
    elif command == "lens":
        open_lens(args[1:])
    elif command == "race":
        return race_command(args[1:])
    elif command == "diff":
        return diff_command(args[1] if len(args) > 1 else None)
    elif command == "take":
        return take_command(args[1] if len(args) > 1 else None)
    elif command == "snap":
        return snap_command(args[1] if len(args) > 1 else None)
    elif command == "undo":
        return undo_command(args[1:])
    elif command in ("language", "lang"):
        change_language()
    elif command == "audience":
        audience_command(args[1] if len(args) > 1 else None)
    elif command == "relay":
        relay_command(args[1] if len(args) > 1 else None)
    elif command == "continue":
        continue_relay()
    elif command == "doctor":
        if args[1:] not in ([], ["--deep"]):
            raise RuntimeError("Usage: rondo doctor [--deep]")
        return doctor("--deep" in args)
    elif command:
        known = [
            "setup", "add", "send", "handoff", "resume", "task", "proof", "review",
            "git", "code-review", "test", "pr", "lens", "race", "diff", "take",
            "snap", "undo", "language", "audience", "relay", "continue", "doctor",
            "kill", "clean",
        ]
        suggestion = difflib.get_close_matches(command, known, n=1)
        message = t("unknown_command", name=command)
        if suggestion:
            message += ". " + t("unknown_suggestion", name=suggestion[0])
        raise RuntimeError(message)
    else:
        open_session()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print()
        raise SystemExit(130)
    except PaneNotReady as error:
        print(f"rondo: {error}", file=sys.stderr)
        raise SystemExit(3)
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"rondo: {error}", file=sys.stderr)
        raise SystemExit(1)
