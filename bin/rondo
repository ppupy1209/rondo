def system_language() -> str:
    value = " ".join(os.environ.get(k, "") for k in ("LC_ALL", "LC_MESSAGES", "LANG"))
    return "ko" if re.search(r"(^|[_. ])ko([_. ]|$)", value, re.I) else "en"


def read_setting(name: str, default: str = "") -> str:
    try:
        return (CONFIG_DIR / name).read_text().strip()
    except OSError:
        return default


def language() -> str:
    forced = os.environ.get("RONDO_LANG", "").lower()
    if forced in TEXT:
        return forced
    saved = read_setting("language")
    return saved if saved in TEXT else system_language()


LANGUAGE = language()


def t(key: str, **values: object) -> str:
    return TEXT[LANGUAGE][key].format(**values)


def write_setting(name: str, value: str) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True, mode=0o700)
    target = CONFIG_DIR / name
    temp = target.with_suffix(".tmp")
    temp.write_text(value.rstrip() + "\n")
    os.chmod(temp, 0o600)
    temp.replace(target)


def migrate_legacy_config() -> None:
    if (CONFIG_DIR / "panels").exists() or not (LEGACY_CONFIG / "panels").exists():
        return
    try:
        panels = (LEGACY_CONFIG / "panels").read_text().strip().split()
    except OSError:
        return
    panels = [name for name in panels if name in AGENTS]
    if panels:
        write_setting("panels", " ".join(panels))
        write_setting("language", system_language())
        write_setting("relay", "ready")
        write_setting("threshold", "1")


def installed(name: str) -> bool:
    return shutil.which(AGENTS[name][1]) is not None


def _read_key() -> str:
    if WINDOWS:
        first = msvcrt.getwch()
        if first == "\x03":
            raise KeyboardInterrupt
        if first in ("\x00", "\xe0"):
            return {"H": "\x1b[A", "P": "\x1b[B"}.get(msvcrt.getwch(), "")
        return first
    first = sys.stdin.buffer.read(1)
    if first == b"\x03":
        raise KeyboardInterrupt
    if first == b"\x1b":
        return (first + sys.stdin.buffer.read(2)).decode("ascii", "ignore")
    return first.decode("utf-8", "ignore")


def _draw(title: str, rows: list[str], hint: str = "") -> None:
    sys.stdout.write("\x1b[2J\x1b[H" + title + "\n\n" + "\n".join(rows))
    if hint:
        sys.stdout.write("\n\n" + hint)
    sys.stdout.flush()


def choose_one(title: str, options: list[tuple[str, str]], default: int = 0) -> str:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        raise RuntimeError(t("need_tty"))
    current = default
    old = termios.tcgetattr(sys.stdin.fileno()) if not WINDOWS else None
    sys.stdout.write("\x1b[?25l")
    try:
        if not WINDOWS:
            tty.setcbreak(sys.stdin.fileno())
        while True:
            rows = [f"  {'›' if i == current else ' '} {label}" for i, (_, label) in enumerate(options)]
            _draw(title, rows, "↑/↓ · Enter")
            key = _read_key()
            if key in ("\x1b[A", "k"):
                current = (current - 1) % len(options)
            elif key in ("\x1b[B", "j"):
                current = (current + 1) % len(options)
            elif key in ("\r", "\n"):
                return options[current][0]
    finally:
        if old is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[2J\x1b[H\x1b[?25h")
        sys.stdout.flush()


def choose_agents(defaults: set[str]) -> list[str]:
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        value = os.environ.get("RONDO_PANELS", "")
        names = value.replace(",", " ").split()
        valid = [name for name in names if name in AGENTS and installed(name)]
        if not valid:
            raise RuntimeError(t("need_tty"))
        return valid

    names = list(AGENTS)
    selected = {name for name in defaults if name in AGENTS and installed(name)}
    current = 0
    old = termios.tcgetattr(sys.stdin.fileno()) if not WINDOWS else None
    sys.stdout.write("\x1b[?25l")
    try:
        if not WINDOWS:
            tty.setcbreak(sys.stdin.fileno())
        while True:
            rows = []
            for i, name in enumerate(names):
                available = installed(name)
                mark = "●" if name in selected else "○"
                state = t("installed") if available else t("missing")
                cursor = "›" if i == current else " "
                rows.append(f"  {cursor} {mark} {name:<8} {AGENTS[name][2]:<24} {state}")
            _draw(t("agent_title"), rows, t("agent_hint"))
            key = _read_key()
            if key in ("\x1b[A", "k"):
                current = (current - 1) % len(names)
            elif key in ("\x1b[B", "j"):
                current = (current + 1) % len(names)
            elif key == " ":
                name = names[current]
                if installed(name):
                    selected.symmetric_difference_update({name})
            elif key in ("\r", "\n") and selected:
                return [name for name in names if name in selected]
            elif key in ("\r", "\n"):
                _draw(t("agent_title"), rows, t("none"))
    finally:
        if old is not None:
            termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, old)
        sys.stdout.write("\x1b[2J\x1b[H\x1b[?25h")
        sys.stdout.flush()


def relay_options() -> list[tuple[str, str]]:
    values = [
        ("off", f"{t('relay_off')} — {t('relay_off_desc')}"),
        ("ready", f"{t('relay_ready')} — {t('relay_ready_desc')}"),
    ]
    if installed("codex"):
        values.append(("auto", f"{t('relay_auto')} — {t('relay_auto_desc')}"))
    return values


def setup() -> None:
    global LANGUAGE
    migrate_legacy_config()
    requested_language = os.environ.get("RONDO_LANG", "").lower()
    if requested_language in TEXT:
        LANGUAGE = requested_language
    else:
        LANGUAGE = choose_one(
            TEXT[LANGUAGE]["language_title"],
            [("ko", "한국어"), ("en", "English")],
            0 if LANGUAGE == "ko" else 1,
        )

    saved = set(read_setting("panels").split())
    defaults = saved or {name for name in DEFAULT_AGENTS if installed(name)}
    panels = choose_agents(defaults)

    requested_relay = os.environ.get("RONDO_RELAY", "").lower()
    valid_modes = {value for value, _ in relay_options()}
    if requested_relay in valid_modes:
        relay = requested_relay
    elif not (sys.stdin.isatty() and sys.stdout.isatty()):
        relay = "ready"
    else:
        current = read_setting("relay", "ready")
        options = relay_options()
        default = next((i for i, item in enumerate(options) if item[0] == current), 1)
        relay = choose_one(t("relay_title"), options, default)
    if relay == "auto" and ("codex" not in panels or not installed("codex")):
        raise RuntimeError(t("select_auto_no_codex"))

    write_setting("language", LANGUAGE)
    write_setting("panels", " ".join(panels))
    write_setting("relay", relay)
    write_setting("threshold", "1")
    print(f"✓ {t('saved')}")
    print(f"  {t('language')}: {'한국어' if LANGUAGE == 'ko' else 'English'}")
    print(f"  {t('panels')}: {' '.join(panels)}")
    print(f"  {t('relay')}: {relay}")
    print(t("login"))


def repo_root() -> Path:
    try:
        result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
        )
    except OSError:
        return Path.cwd()
    return Path(result.stdout.strip()) if result.returncode == 0 else Path.cwd()


def safe_session_name(value: str) -> str:
    name = re.sub(r"[^A-Za-z0-9_.-]+", "-", value).strip("-.")
    return name[:80] or "rondo"


def rondo_session_name(value: str) -> str:
    return safe_session_name(f"rondo-{value}")


def parse_session_list(value: str) -> tuple[set[str], set[str]]:
    active: set[str] = set()
    exited: set[str] = set()
    for line in value.splitlines():
        name = line.split(maxsplit=1)[0] if line.strip() else ""
        if not name:
            continue
        (exited if "(EXITED" in line else active).add(name)
    return active, exited


def zellij_sessions() -> tuple[set[str], set[str]]:
    result = subprocess.run(
        ["zellij", "list-sessions", "-n"], capture_output=True, text=True
    )
    return parse_session_list(result.stdout)


def configured_panels() -> list[str]:
    values = read_setting("panels").split()
    if not values or any(name not in AGENTS for name in values):
        raise RuntimeError(t("bad_config"))
    return values


def pane_command(name: str) -> str:
    if not WINDOWS:
        return AGENTS[name][0]
    if name == "claude":
        return shutil.which(AGENTS[name][1]) or AGENTS[name][1]
    return AGENTS[name][0] + ".cmd"


def write_layout(panels: list[str]) -> Path:
    CACHE_DIR.mkdir(parents=True, exist_ok=True)
    target = CACHE_DIR / "layout.kdl"
    first, rest = panels[0], panels[1:]
    status_command = "rondo-status.cmd" if WINDOWS else "rondo-status"
    lines = [
        "layout {",
        '    tab name="agents" focus=true {',
        f'        pane name="status" command="{status_command}" size=1 borderless=true',
        '        pane split_direction="vertical" {',
        f'            pane name="{first}" command={json.dumps(pane_command(first))} size="50%"',
    ]
    if rest:
        lines.append('            pane split_direction="horizontal" {')
        lines.extend(
            f'                pane name="{name}" command={json.dumps(pane_command(name))}' for name in rest
        )
        lines.append("            }")
    lines.extend(["        }", "    }", '    tab name="shell"', "}"])
    temp = target.with_suffix(".tmp")
    temp.write_text("\n".join(lines) + "\n")
    temp.replace(target)
    return target


def list_sessions() -> None:
    os.execvp("zellij", ["zellij", "list-sessions"])


def open_session(custom_name: str | None = None) -> None:
    migrate_legacy_config()
    if shutil.which("zellij") is None:
        raise RuntimeError(t("not_installed", name="zellij"))
    root = repo_root()
    name = rondo_session_name(custom_name or root.name)
    active, exited = zellij_sessions()
    if name in active:
        os.execvp("zellij", ["zellij", "attach", name])
    if not (CONFIG_DIR / "panels").exists():
        setup()
    panels = configured_panels()
    unavailable = [name for name in panels if not installed(name)]
    if unavailable:
        raise RuntimeError(t("not_installed", name=", ".join(unavailable)))
    layout = write_layout(panels)
    print(f"{t('panels')}: {' '.join(panels)}")
    if name in exited:
        subprocess.run(["zellij", "delete-session", name], check=True)
    os.chdir(root)
    os.execvp("zellij", ["zellij", "-s", name, "-n", str(layout)])


def add_agent(name: str | None) -> None:
    if not name:
        choices = [(key, f"{key} — {value[2]}") for key, value in AGENTS.items() if installed(key)]
        name = choose_one(t("agent_title"), choices)
    if name not in AGENTS:
        raise RuntimeError(t("unknown", name=name))
    if not installed(name):
        raise RuntimeError(t("not_installed", name=name))
    if not os.environ.get("ZELLIJ"):
        raise RuntimeError(t("need_zellij"))
    subprocess.run(["zellij", "action", "go-to-tab-name", "agents"], check=False)
    subprocess.run(["zellij", "action", "move-focus", "down"], check=False)
    os.execvp(
        "zellij",
        ["zellij", "action", "new-pane", "--name", name, "--", pane_command(name)],
    )


def find_agent_pane(name: str) -> str:
    result = subprocess.run(
        ["zellij", "action", "list-panes", "--json"],
        capture_output=True,
        text=True,
        check=True,
    )
    try:
        panes = json.loads(result.stdout)
    except (json.JSONDecodeError, TypeError):
        raise RuntimeError(t("pane_lookup_failed")) from None
    for pane in panes:
        if (
            pane.get("tab_name") == "agents"
            and str(pane.get("title", "")).casefold() == name.casefold()
            and not pane.get("is_plugin")
            and not pane.get("exited")
        ):
            return str(pane["id"])
    raise RuntimeError(t("pane_missing", name=name))


def send_agent_message(name: str | None, parts: list[str]) -> None:
    if name not in AGENTS:
        raise RuntimeError(t("send_usage") if not name else t("unknown", name=name))
    if not os.environ.get("ZELLIJ_SESSION_NAME"):
        raise RuntimeError(t("need_zellij"))
    message = " ".join(parts).strip().replace("\0", "")
    if not message:
        raise RuntimeError(t("empty_message"))
    if len(message) > MAX_AGENT_MESSAGE_CHARS:
        raise RuntimeError(t("message_too_long", max=MAX_AGENT_MESSAGE_CHARS))
    pane = find_agent_pane(name)
    subprocess.run(
        ["zellij", "action", "paste", "--pane-id", pane, "--", message], check=True
    )
    subprocess.run(
        ["zellij", "action", "send-keys", "--pane-id", pane, "Enter"], check=True
    )
    print(t("sent", name=name))


def change_language() -> None:
    global LANGUAGE
    selected = os.environ.get("RONDO_LANG", "").lower()
    if selected not in TEXT:
        selected = choose_one(
            t("language_title"),
            [("ko", "한국어"), ("en", "English")],
            0 if LANGUAGE == "ko" else 1,
        )
    LANGUAGE = selected
    write_setting("language", selected)
    print(f"✓ {t('language')}: {'한국어' if selected == 'ko' else 'English'}")


def relay_index() -> dict | None:
    key = hashlib.sha256(str(repo_root().resolve()).encode()).hexdigest()[:16]
    index = CACHE_DIR / "relay" / key / "pending.json"
    try:
        return json.loads(index.read_text())
    except (OSError, ValueError, TypeError):
        return None


def packet_path() -> Path | None:
    info = relay_index()
    try:
        if info.get("status") != "ready":
            return None
        value = info.get("packet")
        path = Path(value)
        return path if path.exists() else None
    except (AttributeError, TypeError):
        return None


def relay_command(mode: str | None) -> None:
    valid = {"off", "ready", "auto"}
    if mode:
        if mode not in valid:
            raise RuntimeError("relay mode: off | ready | auto")
        if mode == "auto" and (
            not installed("codex") or "codex" not in read_setting("panels").split()
        ):
            raise RuntimeError(t("select_auto_no_codex"))
        write_setting("relay", mode)
        print(t("relay_mode_saved", mode=mode))
        return
    current = read_setting("relay", "ready")
    threshold = read_setting("threshold", "1")
    print(t("relay_status", mode=current, threshold=threshold))
    info = relay_index()
    pending = packet_path()
    if pending:
        print(t("relay_packet", path=pending))
    elif info:
        log = f" · {info['log']}" if info.get("log") else ""
        print(t("relay_last", status=info.get("status", "unknown"), log=log))
    else:
        print(t("relay_empty"))


def continue_relay() -> None:
    exec_script("rondo-relay", "--continue")


def open_lens(args: list[str]) -> None:
    exec_script("rondo-lens", *args)


def script_argv(name: str, *args: str) -> list[str]:
    script = Path(__file__).resolve().with_name(name)
    return [sys.executable, str(script), *args] if WINDOWS else [str(script), *args]


def exec_script(name: str, *args: str) -> None:
    argv = script_argv(name, *args)
    os.execv(argv[0] if WINDOWS else Path(argv[0]), argv)


def doctor(deep: bool = False) -> int:
    print(t("doctor_title"))
    required = [("python", sys.executable, True), ("zellij", "zellij", True)]
    optional = [(name, False) for name in AGENTS]
    failed = False
    for item in required + optional:
        if len(item) == 3:
            name, executable, is_required = item
        else:
            name, is_required = item
            executable = AGENTS[name][1]
        path = shutil.which(executable)
        mark = "✓" if path else ("✗" if is_required else "–")
        state = t("doctor_ok") if path else t("doctor_missing")
        print(f"  {mark} {name:<10} {state}{f' · {path}' if path else ''}")
        failed = failed or (is_required and not path)
    panels = read_setting("panels")
    print(f"  {'✓' if panels else '–'} {t('doctor_config'):<10} {panels or t('doctor_missing')}")
    regressed = deep_probe() if deep else False
    if not deep:
        print(t("doctor_deep_hint"))
    if failed:
        print(t("doctor_hint"))
    return int(failed or regressed)


def deep_probe() -> bool:
    """어댑터별로 지금 실제 읽히는지 확인하고, 벤더 업데이트로 깨진 것을 알린다.

    표시만 하는 진단이라 어댑터 import 실패가 doctor 전체를 죽이면 안 된다.
    """
    try:
        from rondo import registry
    except ImportError as exc:
        print(f"\n{t('doctor_deep_title')}: lib/rondo import 실패 ({exc})")
        return True

    root = repo_root()
    print(f"\n{t('doctor_deep_title')}")
    warnings: list[str] = []
    for adapter in registry.all_adapters():
        if not adapter.installed():
            continue
        version = adapter.version() or t("doctor_unknown_version")
        print(f"  {adapter.name} {version}")
        for check in adapter.diagnose(root):
            mark = "✓" if check.ok else "✗"
            print(f"    {mark} {check.capability:<10} {check.detail}")
        warnings.extend(registry.check_fingerprint(adapter, root))

    for warning in warnings:
        print(f"  ! {t('doctor_changed')}: {warning}")
    return bool(warnings)


def main() -> int:
    args = sys.argv[1:]
    command = args[0] if args else ""
    if command in ("help", "-h", "--help"):
        print(t("usage"), end="")
    elif command in ("--version", "-V"):
        print(f"rondo {VERSION}")
    elif command in ("-l", "--list"):
        list_sessions()
    elif command == "setup":
        setup()
    elif command == "add":
        add_agent(args[1] if len(args) > 1 else None)
    elif command == "send":
        send_agent_message(args[1] if len(args) > 1 else None, args[2:])
    elif command == "lens":
        open_lens(args[1:])
    elif command in ("language", "lang"):
        change_language()
    elif command == "relay":
        relay_command(args[1] if len(args) > 1 else None)
    elif command == "continue":
        continue_relay()
    elif command == "doctor":
        return doctor("--deep" in args)
    elif command:
        open_session(command)
    else:
        open_session()
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except KeyboardInterrupt:
        print()
        raise SystemExit(130)
    except (OSError, RuntimeError, subprocess.SubprocessError) as error:
        print(f"rondo: {error}", file=sys.stderr)
        raise SystemExit(1)
