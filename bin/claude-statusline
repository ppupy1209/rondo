#!/usr/bin/env python3
"""Claude Code statusLine — 모델 · 컨텍스트 · 5시간/주간 한도.

Claude Code 가 stdin 으로 세션 JSON 을 넘긴다. rate_limits 는 구독 계정에서
첫 API 응답 이후에만 들어오므로, 없으면 그 항목을 빼고 출력한다.

부수적으로 파싱한 값을 캐시에 남긴다. Claude 밖에서는 이 데이터를 얻을 방법이
없어서, zellij 상단 바(ai-status)가 이 파일을 읽는다.
"""
import json
import os
import sys
import time

CACHE = os.path.join(
    os.environ.get("XDG_CACHE_HOME") or os.path.expanduser("~/.cache"), "ai-tools"
)


def remaining(epoch):
    secs = max(0, int(epoch - time.time()))
    mins, hours = secs // 60 % 60, secs // 3600
    if hours >= 24:
        return f"{hours // 24}d{hours % 24}h"
    return f"{hours}h{mins:02d}m" if hours else f"{mins}m"


def main():
    try:
        data = json.load(sys.stdin)
    except (json.JSONDecodeError, ValueError):
        return

    model = data.get("model") or {}
    parts = [model.get("display_name") or model.get("id") or "?"]

    effort = (data.get("effort") or {}).get("level")
    if effort:
        parts[0] += f" {effort}"

    used = (data.get("context_window") or {}).get("used_percentage")
    if used is not None:
        parts.append(f"ctx {used:.0f}%")

    limits = data.get("rate_limits") or {}
    for key, label in (("five_hour", "5h"), ("seven_day", "wk")):
        window = limits.get(key)
        if window:
            parts.append(
                f"{label} {window['used_percentage']:.0f}% ({remaining(window['resets_at'])})"
            )

    print(" · ".join(parts))
    stash(data, used, limits)


def stash(data, used, limits):
    """ai-status 가 읽을 캐시. 프로젝트별 파일이라 레포마다 따로 남는다."""
    project = (data.get("workspace") or {}).get("project_dir") or data.get("cwd")
    if not project:
        return
    try:
        os.makedirs(CACHE, exist_ok=True)
        path = os.path.join(CACHE, "claude.%s.json" % os.path.basename(project))
        with open(path, "w") as fh:
            json.dump(
                {
                    "project": project,
                    "model": (data.get("model") or {}).get("display_name"),
                    "context_used": used,
                    "rate_limits": limits,
                    "at": int(time.time()),
                },
                fh,
            )
    except OSError:
        pass


if __name__ == "__main__":
    main()
