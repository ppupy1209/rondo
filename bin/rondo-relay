#!/usr/bin/env python3
"""A read-only, visible feed of messages passed between AI sessions."""

from __future__ import annotations

import os
import sys
import time
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from rondo import core


def main() -> int:
    root = core.find_project_root(Path(os.environ.get("RONDO_PROJECT_ROOT", Path.cwd())))
    core.init_project(root)
    core.register_relay(root, os.environ.get("ZELLIJ_PANE_ID", ""))
    path = core.state_dir(root) / "messages.jsonl"
    print("Rondo Relay - AI 사이의 메시지가 모두 여기에 표시됩니다.")
    print("프로젝트: %s\n" % root)
    for item in core.recent_messages(root, 80):
        print(core.format_message(item), flush=True)
    position = path.stat().st_size if path.exists() else 0
    try:
        while True:
            if not path.exists():
                time.sleep(0.5)
                continue
            size = path.stat().st_size
            if size < position:
                position = 0
            if size > position:
                with path.open("r", encoding="utf-8", errors="replace") as handle:
                    handle.seek(position)
                    for line in handle:
                        try:
                            import json

                            item = json.loads(line)
                        except (ValueError, TypeError):
                            continue
                        print(core.format_message(item), flush=True)
                    position = handle.tell()
            time.sleep(0.5)
    except KeyboardInterrupt:
        return 0
    finally:
        core.close_relay(root)


if __name__ == "__main__":
    raise SystemExit(main())
